  "instructions": {
    "setup": [
      "Adjust the seat height so the machine handles sit level with your lower chest.",
      "Sit back firmly against the pad with your head, upper back, and glutes supported.",
      "Plant both feet flat on the floor to provide a stable base.",
      "Grasp the handles with an overhand grip, pull your shoulder blades down and back, and brace your core."
    ],
    "steps": [
      "Press the handles smoothly forward and downward along the machine's track by extending your elbows.",
      "Continue pressing until your arms are fully extended without hard-locking your elbows.",
      "Squeeze your chest at full extension for a brief moment.",
      "Lower the handles under control, feeling a deep stretch across the lower pectorals, until the handles return near chest level."
    ],
    "breathing": "Exhale as you press the handles forward; inhale as you control the weight back to the starting position.",
    "cues": [
      "Keep your chest proud and shoulders pinned back.",
      "Press down and through your palms.",
      "Control the descent; do not let the weight slam."
    ],
    "common_faults": [
      {
        "fault": "Protracted, rounded shoulders at lockout.",
        "correction": "Keep your shoulder blades depressed and retracted into the back pad throughout the entire movement."
      },
      {
        "fault": "Seat height set too low or too high.",
        "correction": "Set the seat so the handles align directly with the lower border of your chest, not up near your shoulders."
      },
      {
        "fault": "Flaring the elbows out excessively.",
        "correction": "Tuck your elbows to roughly a 45-degree angle relative to your torso as you press."
      }
    ],
    "safety": {
      "precautions": [
        "Ensure the seat adjustment pin is fully locked before loading weight."
      ],
      "spotter": "not-needed"
    }
  },
