  "instructions": {
    "setup": [
      "Stand tall with feet shoulder-width apart, knees slightly soft, and pelvis facing forward.",
      "Bend your elbows and hold your hands at chest height or across your shoulders."
    ],
    "steps": [
      "Rotate your torso smoothly to one side, initiating the movement through your ribs and thoracic spine.",
      "Pause briefly at the comfortable end of your active range of motion while keeping your hips relatively square.",
      "Rotate back through the center and smoothly twist to the opposite side."
    ],
    "breathing": "Maintain a steady, rhythmic breathing pattern, exhaling as you reach maximum rotation on each side.",
    "cues": [
      "Twist from the ribs, not the knees",
      "Keep hips facing forward",
      "Move with control, don't whip"
    ],
    "common_faults": [
      {
        "fault": "Swiveling the hips and knees aggressively, transferring rotational torque into the knee joints.",
        "correction": "Anchor your feet firmly and keep the pelvis relatively steady, focusing rotation in the mid-back and core."
      },
      {
        "fault": "Using uncontrolled momentum or ballistic whipping motions.",
        "correction": "Control the rotation actively with your abdominal musculature through a smooth, deliberate arc."
      }
    ],
    "safety": {
      "precautions": [
        "Avoid aggressive over-rotation if experiencing acute lumbar spine irritation or disc issues."
      ],
      "spotter": "not-needed"
    }
  },
