  "id": "oec:incline-dumbbell-y-raise",
  "instructions": {
    "setup": [
      "Set an adjustable bench to an incline of 30 to 45 degrees.",
      "Lie face down on the bench with your chest firmly supported and your head in a neutral position.",
      "Hold a light dumbbell in each hand with your arms hanging down and thumbs pointed upward."
    ],
    "steps": [
      "Keeping your elbows nearly straight, raise the dumbbells diagonally upward and outward at roughly a 30- to 45-degree angle from your torso, forming a Y shape.",
      "Lift until your arms align with your torso, feeling your lower and mid-trapezius contract.",
      "Pause briefly at the top without shrugging your shoulders into your ears.",
      "Lower the dumbbells smoothly under control back to the starting hanging position."
    ],
    "breathing": "Exhale as you raise the dumbbells into the Y position and inhale as you lower them.",
    "cues": [
      "Lead with your thumbs.",
      "Form a Y, not a T.",
      "Keep your shoulders down away from your ears."
    ],
    "common_faults": [
      {
        "fault": "Excessively shrugging the shoulders upward using the upper traps.",
        "correction": "Depress your shoulder blades before raising and focus on rotating the scapulae upward rather than shrugging."
      },
      {
        "fault": "Using momentum or arching the lower back off the bench.",
        "correction": "Keep your chest glued to the pad and select lighter dumbbells to isolate the movement."
      },
      {
        "fault": "Raising the arms straight out to the sides into a T shape instead of a Y.",
        "correction": "Angle your arms roughly 30 to 45 degrees forward into the scapular plane."
      }
    ],
    "safety": {
      "precautions": [
        "Use very light weights to protect the rotator cuff and avoid neck strain."
      ],
      "spotter": "not-needed"
    }
  },
