  "instructions": {
    "setup": [
      "Sit on a flat bench or the floor with one knee raised and bent to approximately 90 degrees.",
      "Hold a light dumbbell in the working hand and rest the elbow on top of the raised knee.",
      "Position your upper arm perpendicular to your torso and bend the elbow to a fixed 90-degree angle."
    ],
    "steps": [
      "Maintain a stable, upright posture and stabilize the shoulder blade.",
      "Rotate your shoulder to raise the dumbbell upward until your forearm is vertical.",
      "Pause briefly at the top of the movement.",
      "Slowly lower the dumbbell back down under control until your forearm is roughly parallel to the ground.",
      "Complete the set and repeat on the opposite side."
    ],
    "breathing": "Exhale as you rotate the weight upward and inhale as you lower it under control.",
    "cues": [
      "Keep the elbow pinned to the knee",
      "Pivot cleanly through the shoulder",
      "Maintain a strict 90-degree elbow bend"
    ],
    "common_faults": [
      {
        "fault": "Extending the elbow instead of rotating the shoulder",
        "correction": "Lock the elbow at 90 degrees throughout the entire repetition so only the shoulder rotates."
      },
      {
        "fault": "Shrugging the shoulder or using excessive body English to lift the weight",
        "correction": "Keep your shoulder blade retracted and depressed, and choose a lighter load."
      },
      {
        "fault": "Rushing through the eccentric phase",
        "correction": "Lower the dumbbell smoothly over two to three seconds to maintain constant muscular tension."
      }
    ],
    "safety": {
      "precautions": [
        "Start with very light weights, as the external rotators are small muscles prone to strain when overloaded."
      ],
      "spotter": "not-needed"
    }
  },
