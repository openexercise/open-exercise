  "id": "oec:machine-chest-fly",
  "instructions": {
    "setup": [
      "Adjust the seat height so the handles or arm pads align with the middle of your chest.",
      "Sit back firmly with your head, upper back, and glutes supported against the pad, feet flat on the floor.",
      "Grasp the handles or position your forearms against the pads with a slight, fixed bend in your elbows."
    ],
    "steps": [
      "Inhale, brace your core, and set your shoulder blades back and down against the backrest.",
      "Bring the handles together in front of your chest in a smooth, hugging arc.",
      "Pause briefly at peak contraction, squeezing your pectorals firmly without touching the handles together.",
      "Reverse the movement with control, feeling a deep stretch across your chest before the weight stack touches down."
    ],
    "breathing": "Exhale as you pull the handles together; inhale as you slowly return to the stretched starting position.",
    "cues": [
      "Hug a wide barrel.",
      "Lead with the elbows rather than the hands.",
      "Keep your chest high and shoulders pinned to the pad."
    ],
    "common_faults": [
      {
        "fault": "Allowing the shoulders to round forward at full contraction.",
        "correction": "Keep your shoulder blades retracted and depressed against the backrest throughout the entire rep."
      },
      {
        "fault": "Changing the elbow bend during the movement to turn the fly into a press.",
        "correction": "Lock in a soft elbow angle at the start and maintain it unchanged from start to finish."
      },
      {
        "fault": "Overstretching the shoulders backward at the start of the rep.",
        "correction": "Adjust the machine's range-of-motion cam so your elbows do not travel excessively behind the plane of your torso."
      }
    ],
    "safety": {
      "precautions": [
        "Do not allow the weights to violently yank your arms backward into excessive external rotation and horizontal abduction."
      ],
      "spotter": "not-needed"
    }
  },
