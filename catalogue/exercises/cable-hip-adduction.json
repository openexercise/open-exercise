  "instructions": {
    "setup": [
      "Attach an ankle cuff to a low pulley cable and secure it around the ankle closest to the machine.",
      "Step away slightly so there is tension on the cable, standing upright with the working leg slightly abducted.",
      "Grip the cable machine frame with your hand for balance, keeping your torso tall and hips square."
    ],
    "steps": [
      "Pull your cuffed leg smoothly across the midline of your body and in front of the supporting leg.",
      "Pause momentarily at the point of peak adduction, squeezing the inner thigh.",
      "Slowly return the working leg to the starting position under control, resisting the cable tension."
    ],
    "breathing": "Exhale as you adduct the leg across your body; inhale as you slowly return to the starting position.",
    "cues": [
      "Pull from the inner thigh",
      "Keep your hips square",
      "Stand tall and avoid leaning"
    ],
    "common_faults": [
      {
        "fault": "Leaning the torso to generate momentum.",
        "correction": "Keep the spine upright and brace the core so movement occurs strictly at the hip joint."
      },
      {
        "fault": "Swinging the leg ballistically.",
        "correction": "Perform the movement smoothly with a controlled eccentric return."
      }
    ],
    "safety": {
      "precautions": [
        "Hold onto the cable upright to maintain steady balance throughout the set."
      ],
      "spotter": "not-needed"
    }
  },
