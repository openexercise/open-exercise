  "instructions": {
    "setup": [
      "Stand tall with feet hip-width apart and knees unlocked.",
      "Hold a dumbbell in each hand at your sides with arms fully extended and palms facing inward."
    ],
    "steps": [
      "Curl one dumbbell upward by flexing the elbow while keeping the upper arm pinned near your torso.",
      "Rotate your forearm into a supinated position as the dumbbell rises so your palm faces your shoulder at the top.",
      "Squeeze your bicep firmly at peak contraction without swinging your shoulder forward.",
      "Lower the dumbbell under control back to full extension, rotating your wrist back to neutral.",
      "Repeat the movement with the opposite arm to complete one alternating pair."
    ],
    "breathing": "Exhale while curling the dumbbell up; inhale as you lower it back to your side.",
    "cues": [
      "Keep elbows tucked",
      "Turn pinky up at the top",
      "Control the descent",
      "No torso sway"
    ],
    "common_faults": [
      {
        "fault": "Swinging the torso or using hip drive to lift the dumbbell.",
        "correction": "Brace the core, keep knees soft, and use a lighter weight to isolate the elbow flexors."
      },
      {
        "fault": "Elbows drifting forward during the curl, turning it into front shoulder work.",
        "correction": "Keep the upper arms stationary against the ribs throughout the movement."
      },
      {
        "fault": "Cutting the bottom range of motion short.",
        "correction": "Allow the working arm to straighten fully before starting the next rep."
      }
    ],
    "safety": {
      "precautions": [
        "Avoid hyperextending the lower back while lifting heavy weights."
      ],
      "spotter": "not-needed"
    }
  },
