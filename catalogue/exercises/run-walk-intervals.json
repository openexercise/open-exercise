    "setup": [
      "Stand tall outdoors on a flat, safe surface, or step onto a treadmill.",
      "Set your interval timer or monitor for your desired walk and run durations."
    ],
    "steps": [
      "Begin by walking at a brisk, purposeful recovery pace for the designated walking interval.",
      "Smoothly transition into an easy jog or run as the interval timer signals the work bout.",
      "Maintain an upright posture, relaxed shoulders, and a smooth cadence throughout the jog.",
      "Decelerate back to a walk at the end of the running interval and repeat for the target duration."
    ],
    "breathing": "Maintain a steady, rhythmic breathing pattern matched to your footfalls, avoiding holding your breath during running phases.",
    "cues": [
      "Stay tall through the torso",
      "Smooth transitions",
      "Keep shoulders relaxed"
    ],
    "common_faults": [
      {
        "fault": "Sprinting during the run interval and becoming too exhausted to complete subsequent sets.",
        "correction": "Keep the running pace conversational and controlled to sustain the intervals over time."
      },
      {
        "fault": "Overstriding during the transition to a jog, leading to excessive heel striking and joint impact.",
        "correction": "Land with feet beneath your hips using a quick, light turnover."
      }
    ],
