  "id": "oec:cable-single-arm-triceps-pushdown",
  "instructions": {
    "setup": [
      "Set the cable pulley to its highest position and attach a single D-handle or grip the cable end.",
      "Stand facing the pulley with feet in a stable, staggered stance and a slight forward lean at the hips.",
      "Grasp the handle with one hand and pin your upper arm close to your torso with the elbow bent to roughly 90 degrees."
    ],
    "steps": [
      "Keep your upper arm stationary against your flank and push the handle downward by extending your elbow.",
      "Contract your triceps forcefully at full elbow lockout.",
      "Bend your elbow under control to return the cable to the starting position without allowing the upper arm to swing forward.",
      "Complete the desired repetitions on one arm, then repeat on the opposite side."
    ],
    "breathing": "Exhale as you push down and fully extend the elbow; inhale as you control the handle back up to the start.",
    "cues": [
      "Pin your elbow to your side.",
      "Move only your forearm.",
      "Lock out and squeeze."
    ],
    "common_faults": [
      {
        "fault": "Swinging the upper arm forward and back to gain momentum.",
        "correction": "Keep the upper arm glued to your ribs throughout the movement so only the elbow flexes and extends."
      },
      {
        "fault": "Letting the shoulder roll forward or elevate during the press.",
        "correction": "Set your shoulder blade down and back before starting the repetition."
      },
      {
        "fault": "Cutting the eccentric phase short.",
        "correction": "Allow your elbow to achieve at least 90 degrees of flexion on each repetition before pushing back down."
      }
    ],
    "safety": {
      "spotter": "not-needed"
    }
  },
