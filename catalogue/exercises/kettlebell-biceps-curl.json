  "instructions": {
    "setup": [
      "Stand tall with feet hip-width apart and your core braced.",
      "Grasp a single kettlebell with both hands by the sides of the handle (the horns), letting it hang at arm's length in front of your thighs."
    ],
    "steps": [
      "Keep your upper arms pinned close to your ribs and curl the kettlebell upward toward chest height by flexing your elbows.",
      "Squeeze your biceps firmly at the top of the movement.",
      "Lower the kettlebell under control back to full elbow extension."
    ],
    "breathing": "Exhale as you curl the kettlebell upward; inhale as you lower it with control.",
    "cues": [
      "Elbows glued to ribs",
      "Chest up, no swinging",
      "Squeeze at the top"
    ],
    "common_faults": [
      {
        "fault": "Swinging the torso and using hip momentum to lift the kettlebell.",
        "correction": "Brace the glutes and core to keep the torso stationary throughout the curl."
      },
      {
        "fault": "Flaring the elbows outward or allowing them to drift forward.",
        "correction": "Keep the elbows tucked against your sides so the biceps perform the work."
      }
    ],
    "safety": {
      "precautions": [
        "Maintain a firm grip on the horns to prevent the kettlebell from slipping."
      ],
      "spotter": "not-needed"
    }
  },
