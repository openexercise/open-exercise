  "instructions": {
    "setup": [
      "Sit at the end of a flat bench with your feet placed flat on the floor, roughly hip-width apart.",
      "Hold a dumbbell in each hand and hinge forward from your hips until your torso rests on or just above your thighs.",
      "Let your arms hang straight down behind your calves with your palms facing each other and a slight, fixed bend in your elbows."
    ],
    "steps": [
      "Initiate the movement by raising the dumbbells out to the sides in a wide semicircular arc.",
      "Continue lifting until your upper arms are approximately parallel to the floor and aligned with your shoulders.",
      "Pause briefly at the top of the motion to fully contract your posterior deltoids.",
      "Lower the dumbbells back down along the same path under control until they return to the starting position."
    ],
    "breathing": "Exhale as you raise the dumbbells outward and inhale as you lower them smoothly under control.",
    "cues": [
      "Lead with your elbows.",
      "Keep your torso pinned to your thighs.",
      "Reach wide, not back."
    ],
    "common_faults": [
      {
        "fault": "Swinging the torso to use momentum to lift the weights.",
        "correction": "Keep your chest resting against or close to your thighs and use a lighter load that permits strict isolation."
      },
      {
        "fault": "Excessively flexing the elbows and turning the movement into a row.",
        "correction": "Maintain a soft, locked bend at the elbow joint throughout the entire range of motion."
      },
      {
        "fault": "Shrugging the shoulders toward the ears, shifting tension to the upper traps.",
        "correction": "Depress your scapulae and sweep the arms out wide rather than lifting straight up."
      }
    ],
    "safety": {
      "precautions": [
        "Choose conservative weights to protect the shoulder joint and prevent form breakdown."
      ],
      "spotter": "not-needed"
    }
  },
