  "id": "oec:machine-chest-press",
  "instructions": {
    "setup": [
      "Adjust the seat height so that the machine handles align horizontally with mid-to-lower chest level.",
      "Sit back firmly against the back pad with your feet flat on the floor.",
      "If equipped, depress the foot assist pedal to bring the handles forward into a comfortable starting position.",
      "Grasp the handles with an overhand or neutral grip and retract your shoulder blades against the pad."
    ],
    "steps": [
      "Release the foot pedal smoothly while holding the handles with tension on your chest.",
      "Press the handles away by extending your elbows and squeezing your chest.",
      "Push until your arms are fully extended without aggressively locking out your elbows or letting your shoulders roll forward.",
      "Slowly reverse the movement, controlling the weight back until your chest experiences a full stretch."
    ],
    "breathing": "Exhale as you press the handles forward, and inhale as you lower the weight back under control.",
    "cues": [
      "Keep your chest proud against the pad",
      "Drive through your palms",
      "Don't let the shoulders roll forward at the finish"
    ],
    "common_faults": [
      {
        "fault": "Setting the seat too low, causing the handles to align with the neck and overstressing the shoulders.",
        "correction": "Raise the seat so the handles align directly with the middle or lower line of the pectoral muscles."
      },
      {
        "fault": "Protraction and shrugging shoulders off the back pad at full extension.",
        "correction": "Keep your shoulder blades pulled back and down against the pad throughout the entire range of motion."
      },
      {
        "fault": "Letting the weight stack slam down between repetitions.",
        "correction": "Maintain continuous muscular tension and stop just short of the weight plates touching at the bottom."
      }
    ],
    "safety": {
      "precautions": [
        "Use the foot-assist pedal if available to protect the shoulders when entering and exiting heavy sets."
      ],
      "spotter": "not-needed"
    }
  },
