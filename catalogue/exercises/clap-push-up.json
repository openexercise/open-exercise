  "instructions": {
    "setup": [
      "Assume a standard high plank position with hands slightly wider than shoulder-width apart.",
      "Engage your abdominals and glutes to align your body in a rigid straight line from head to heels."
    ],
    "steps": [
      "Lower your chest toward the floor in a controlled manner until your elbows reach approximately a ninety-degree angle.",
      "Explosively press through the palms to launch your upper body into the air.",
      "Quickly clap your hands together under your chest at the peak of the flight phase.",
      "Immediately return your hands to the floor, landing with soft, slightly bent elbows to absorb the impact smoothly into the next descent."
    ],
    "breathing": "Inhale as you lower your chest toward the floor, and exhale forcefully as you drive up into the clap.",
    "cues": [
      "Explode off the floor",
      "Quick clap",
      "Soft landing"
    ],
    "common_faults": [
      {
        "fault": "Landing with fully locked elbows, creating harsh impact on the joints.",
        "correction": "Catch yourself with soft, bent arms and immediately yield into the next repetition."
      },
      {
        "fault": "Sagging the lower back or piking the hips during the explosive drive.",
        "correction": "Maintain rigid core and glute tension to keep the spine neutral throughout the airborne phase."
      }
    ],
    "safety": {
      "precautions": [
        "Ensure you can comfortably perform high-rep standard push-ups before attempting ballistic push-up variations.",
