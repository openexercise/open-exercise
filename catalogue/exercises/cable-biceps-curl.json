  "id": "oec:cable-biceps-curl",
  "instructions": {
    "setup": [
      "Attach a straight or EZ-curl bar to a low cable pulley.",
      "Stand facing the pulley with feet hip-width apart and grasp the bar with an underhand, shoulder-width grip.",
      "Step back slightly so there is tension on the cable with arms fully extended and elbows tucked close to your torso."
    ],
    "steps": [
      "Keeping your upper arms stationary by your sides, curl the bar upward toward your shoulders by flexing your elbows.",
      "Squeeze your biceps hard at the peak contraction.",
      "Slowly lower the bar back to the starting position under control, fully extending your elbows before beginning the next rep."
    ],
    "breathing": "Exhale as you curl the weight upward; inhale as you lower it back down.",
    "cues": [
      "Pin your elbows to your sides",
      "Move only your forearms",
      "Control the descent against the cable's pull"
    ],
    "common_faults": [
      {
        "fault": "Swinging the torso to build momentum",
        "correction": "Keep your core braced and stand upright, reducing the load if necessary to eliminate body swing."
      },
      {
        "fault": "Allowing elbows to drift forward excessively during the curl",
        "correction": "Lock the upper arms along the ribcage so the biceps perform the work rather than the anterior deltoids."
      },
      {
        "fault": "Cutting the eccentric range short",
        "correction": "Lower the bar all the way until the elbows reach full extension to take advantage of continuous cable tension."
      }
    ],
    "safety": {
      "precautions": [
        "Maintain a stable base of support and avoid hyperextending the lower back under heavy loads"
      ],
      "spotter": "not-needed"
    }
  },
