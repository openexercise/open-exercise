  "instructions": {
    "setup": [
      "Position a bench perpendicular to a cable pulley adjusted to chest height.",
      "Sit upright on the bench with your side facing the cable machine, feet flat on the floor for stability.",
      "Grasp the single handle with both hands, extending your arms straight out in front of your chest with a slight unlock at the elbows."
    ],
    "steps": [
      "Brace your abdominals and maintain a tall, upright posture.",
      "Rotate your torso smoothly away from the machine, keeping your arms locked relative to your chest.",
      "Pause briefly at the end of the rotation, actively contracting your obliques.",
      "Slowly reverse the rotation under control back to the starting position without letting the weight stack slam.",
      "Complete the desired repetitions on one side before turning around to train the opposite side."
    ],
    "breathing": "Exhale as you rotate your torso away from the pulley; inhale as you slowly return to the start.",
    "cues": [
      "Turn from the ribs, not the arms.",
      "Keep the chest proud and tall.",
      "Anchor your hips to the bench."
    ],
    "common_faults": [
      {
        "fault": "Swinging the arms independently of the torso.",
        "correction": "Keep the hands centered with your sternum so the rotation is driven purely by the midsection."
      },
      {
        "fault": "Allowing the pelvis and hips to shift or lift off the bench.",
        "correction": "Press firmly through your feet and maintain even sit-bone contact on the bench throughout the set."
      },
      {
        "fault": "Excessive lumbar rounding during rotation.",
        "correction": "Sit tall with a neutral spine and rotate primarily through the mid-to-upper back."
      }
    ],
    "safety": {
      "precautions": [
        "Avoid using excessive loads that force aggressive twisting at the lower back."
      ],
      "spotter": "not-needed"
    }
  },
