  "instructions": {
    "setup": [
      "Stand tall with feet hip-width apart, holding a dumbbell in each hand at your sides.",
      "Maintain a soft bend in your knees, brace your core, and establish a very slight forward torso lean.",
      "Keep a slight, fixed bend in your elbows throughout the movement."
    ],
    "steps": [
      "Raise the dumbbells outward and slightly forward in the scapular plane until your elbows reach approximately shoulder height.",
      "Pause briefly at the top of the contraction without shrugging your shoulders into your ears.",
      "Lower the dumbbells smoothly back to your sides under control."
    ],
    "breathing": "Exhale as you raise the dumbbells outward and inhale as you lower them under control.",
    "cues": [
      "Lead with your elbows.",
      "Pour water from a pitcher at the top.",
      "Reach out toward the walls rather than straight up."
    ],
    "common_faults": [
      {
        "fault": "Swinging the torso to generate momentum.",
        "correction": "Reduce the load and keep your core braced to isolate the shoulders without rocking."
      },
      {
        "fault": "Excessive shrugging with the upper traps.",
        "correction": "Keep your shoulder blades depressed and focus on driving your elbows out wide rather than lifting with your neck."
      },
      {
        "fault": "Bending and straightening the elbows during the rep.",
        "correction": "Lock a slight elbow bend in place during setup and maintain it for the entire set."
      }
    ],
    "safety": {
      "precautions": [
        "Avoid raising the weights significantly above shoulder height if experiencing shoulder impingement or pain."
      ],
      "spotter": "not-needed"
    }
  },
