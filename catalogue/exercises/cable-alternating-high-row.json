  "instructions": {
    "setup": [
      "Set a cable pulley to a high position above head height and attach a single D-handle.",
      "Grip the handle with one hand and take a step back from the cable stack into a stable, staggered stance.",
      "Extend your working arm upward along the line of the cable, bracing your core and keeping your chest tall."
    ],
    "steps": [
      "Drive your elbow down and back toward your hip, retracting your shoulder blade as you pull the handle to your lower ribcage.",
      "Pause momentarily at peak contraction while resisting excessive torso twist.",
      "Control the weight back to the fully extended starting position under tension.",
      "Switch hands and shift your stance to repeat the movement on the opposite side."
    ],
    "breathing": "Exhale as you pull the cable toward your torso and inhale as you return the arm to full extension.",
    "cues": [
      "Drive the elbow to your hip pocket.",
      "Keep your chest proud and resist twisting.",
      "Control the stretch at the top."
    ],
    "common_faults": [
      {
        "fault": "Excessive torso rotation and momentum to move the load.",
        "correction": "Brace your core and keep your shoulders relatively square, using the back muscles to pull rather than swinging your torso."
      },
      {
        "fault": "Shrugging the shoulder toward the ear during the pull.",
        "correction": "Depress your shoulder blade and lead the movement by driving the elbow downward."
      }
    ],
    "safety": {
      "precautions": [
        "Maintain a solid staggered stance to avoid being pulled off balance by the cable."
      ],
      "spotter": "not-needed"
    }
  },
