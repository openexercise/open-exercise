  "instructions": {
    "setup": [
      "Set an adjustable bench to an incline of approximately 45 degrees.",
      "Straddle the bench and lie prone with your chest securely supported against the pad and your feet firmly planted on the floor.",
      "Grasp a dumbbell in each hand with an underhand (supinated) grip, letting your arms hang perpendicular to the floor."
    ],
    "steps": [
      "Keeping your upper arms stationary and perpendicular to the floor, curl the dumbbells upward by flexing at the elbows.",
      "Continue raising the weights until your biceps are fully contracted, pausing briefly at the peak contraction.",
      "Lower the dumbbells smoothly back down under control until your elbows are fully extended."
    ],
    "breathing": "Exhale as you curl the dumbbells toward your shoulders and inhale as you lower them.",
    "cues": [
      "Keep upper arms pinned perpendicular to the floor.",
      "Squeeze biceps hard at the peak.",
      "Control the descent without swinging."
    ],
    "common_faults": [
      {
        "fault": "Swinging the upper arms backward during the curl to generate momentum.",
        "correction": "Keep the humerus vertical throughout the repetition, flexing only at the elbow joint."
      },
      {
        "fault": "Hyperextending the neck to look up while performing the movement.",
        "correction": "Maintain a neutral cervical spine by gazing slightly forward and down toward the floor."
      }
    ],
    "safety": {
      "precautions": [
        "Ensure the bench angle is securely locked before lying against it."
      ],
      "spotter": "not-needed"
    }
  },
