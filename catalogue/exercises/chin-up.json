  "instructions": {
    "setup": [
      "Grasp an overhead bar with a shoulder-width, supinated grip (palms facing toward you).",
      "Hang with your arms fully extended in a dead hang or active hang, legs extended or crossed with knees slightly bent.",
      "Engage your core to prevent excessive swinging."
    ],
    "steps": [
      "Initiate the pull by drawing your shoulder blades down and back.",
      "Drive your elbows down and toward your ribs to pull your chest up toward the bar.",
      "Continue pulling until your chin clears the height of the bar.",
      "Pause briefly at the top without straining the neck forward.",
      "Lower yourself under control until your elbows reach full extension."
    ],
    "breathing": "Inhale at the bottom or on the way down; exhale as you pull yourself up.",
    "cues": [
      "Drive your elbows to the floor.",
      "Chest to the bar.",
      "Keep your ribs pulled down."
    ],
    "common_faults": [
      {
        "fault": "Kicking the legs or swinging the hips to gain momentum.",
        "correction": "Brace the abdominal muscles and maintain a stable hollow-body or slightly braced position throughout."
      },
      {
        "fault": "Reaching with the chin to clear the bar instead of completing the pull.",
        "correction": "Keep the neck neutral and pull until the chin naturally clears the bar through shoulder and elbow flexion."
      },
      {
        "fault": "Cutting the bottom range of motion short.",
        "correction": "Lower completely until the arms are fully extended before beginning the next repetition."
      }
    ],
    "safety": {
      "precautions": [
        "Ensure the pull-up bar is securely mounted and capable of supporting your full body weight."
      ],
      "spotter": "not-needed"
    }
  },
