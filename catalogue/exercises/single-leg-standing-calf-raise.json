  "instructions": {
    "setup": [
      "Stand on one foot on a flat surface or place the ball of the foot on the edge of an elevated step with the heel hanging off.",
      "Bend or hook the non-working leg behind the working ankle.",
      "Lightly place a hand on a wall or stable support to maintain balance."
    ],
    "steps": [
      "Lower your heel under control until you feel a deep, comfortable stretch in the calf.",
      "Press straight down through the ball of your foot and big toe to raise your heel as high as possible into full plantarflexion.",
      "Squeeze your calf at the peak contraction for a brief pause.",
      "Lower slowly back down to the fully stretched position.",
      "Complete the desired repetitions, then switch to the opposite leg."
    ],
    "breathing": "Exhale as you press upward onto the ball of your foot; inhale smoothly as you lower your heel.",
    "cues": [
      "Drive through the big toe",
      "Pause and squeeze at the top",
      "Slow on the descent"
    ],
    "common_faults": [
      {
        "fault": "Bouncing out of the bottom stretch to use elastic recoil from the Achilles tendon.",
        "correction": "Pause briefly at the bottom of each repetition to remove the elastic bounce."
      },
      {
        "fault": "Rolling the ankle outward onto the pinky toe.",
        "correction": "Distribute your weight evenly across the forefoot, pressing firmly through the first metatarsal head and big toe."
      },
      {
        "fault": "Bending the working knee during the ascent.",
        "correction": "Keep the knee extended with a soft lock throughout the entire set to maximize gastrocnemius involvement."
      }
    ],
    "safety": {
      "precautions": [
        "Ensure you have a sturdy surface to touch for balance so you do not lose footing."
      ],
      "spotter": "not-needed"
    }
  },
