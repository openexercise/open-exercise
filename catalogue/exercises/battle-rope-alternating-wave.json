  "instructions": {
    "setup": [
      "Stand facing the anchor point holding one end of the battle rope in each hand with a neutral grip.",
      "Step back until there is a slight amount of slack in the ropes.",
      "Assume an athletic quarter-squat stance with feet shoulder-width apart, chest tall, and core braced."
    ],
    "steps": [
      "Raise one arm quickly toward shoulder height while driving the other downward toward hip level.",
      "Immediately reverse the motion, snapping the opposite arm upward and driving the raised arm down.",
      "Continue alternating arms rapidly to create continuous, fluid waves that travel all the way to the anchor point."
    ],
    "breathing": "Maintain rhythmic, continuous breathing throughout the interval rather than holding your breath.",
    "cues": [
      "Fast hands, quiet torso.",
      "Whip from the shoulders.",
      "Stay rooted in your hips."
    ],
    "common_faults": [
      {
        "fault": "Excessive torso swaying and twisting.",
        "correction": "Brace your core and keep your chest facing directly forward throughout the set."
      },
      {
        "fault": "Standing completely upright with locked knees.",
        "correction": "Maintain a solid athletic stance with knees and hips slightly bent to absorb momentum."
      },
      {
        "fault": "Standing too far back with overly taut ropes.",
        "correction": "Step forward slightly to allow enough slack for waves to travel freely."
      }
    ],
    "safety": {
      "precautions": [
        "Ensure the anchor point is secure and the floor is clear of slip or trip hazards."
      ],
      "spotter": "not-needed"
    }
  },
