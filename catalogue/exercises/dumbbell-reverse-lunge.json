  "instructions": {
    "setup": [
      "Stand tall with feet hip-width apart holding a dumbbell in each hand at your sides with arms fully extended.",
      "Engage your core, pull your shoulders back and down, and keep your chest upright."
    ],
    "steps": [
      "Take a controlled step backward with one leg, landing on the ball of the rear foot.",
      "Lower your hips straight down until the front thigh is roughly parallel to the floor and the back knee hovers just above the ground.",
      "Drive firmly through the midfoot and heel of the front foot to push yourself back up to the starting position.",
      "Complete the desired repetitions on one side before switching, or alternate legs as programmed."
    ],
    "breathing": "Inhale as you step back and lower into the lunge; exhale forcefully as you drive through the front foot to return to standing.",
    "cues": [
      "Railroad tracks, not a tightrope",
      "Drive through the front heel",
      "Keep your torso tall"
    ],
    "common_faults": [
      {
        "fault": "Stepping the rear foot directly behind the front foot, causing loss of balance.",
        "correction": "Maintain hip-width spacing between your feet as you step backward."
      },
      {
        "fault": "Slamming the rear knee into the floor.",
        "correction": "Lower under control and stop just before the rear knee makes hard contact with the ground."
      },
      {
        "fault": "Excessive forward torso collapse over the front thigh.",
        "correction": "Keep your abdominal wall braced and your chest lifted throughout the movement."
      }
    ],
    "safety": {
      "precautions": [
        "Ensure the floor space behind you is clear of equipment before stepping back."
      ],
      "spotter": "not-needed"
    }
  },
