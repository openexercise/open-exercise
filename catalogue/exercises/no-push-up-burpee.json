  "instructions": {
    "setup": [
      "Stand tall with your feet shoulder-width apart and your arms at your sides."
    ],
    "steps": [
      "Hinge at the hips and bend your knees to lower into a squat, placing both hands flat on the floor directly beneath your shoulders.",
      "Jump both feet straight back into a high plank position, maintaining a rigid straight line from head to heels.",
      "Quickly jump your feet forward, landing flat-footed just behind your hands in a low squat position.",
      "Explode vertically off the floor into a jump, reaching your arms overhead.",
      "Land softly on the balls of your feet, immediately absorbing the impact by sinking into the next repetition."
    ],
    "breathing": "Inhale as you squat down and jump your feet back, then exhale sharply as you jump your feet in and explode off the floor.",
    "cues": [
      "Hands down, kick back, snap forward, jump high",
      "Brace your core in the plank to prevent hip sag",
      "Land softly on the feet"
    ],
    "common_faults": [
      {
        "fault": "Sagging the hips and hyperextending the lower back when kicking out into the plank.",
        "correction": "Squeeze the glutes and brace the abdominals to lock into a rigid plank position before jumping forward."
      },
      {
        "fault": "Landing on the toes with knees caving in when jumping back to the squat.",
        "correction": "Jump the feet wide enough to plant the whole foot flat on the floor with knees tracking over toes."
      },
      {
        "fault": "Landing with stiff, locked knees on the vertical jump.",
        "correction": "Absorb the landing softly through the ankles, knees, and hips, transitioning smoothly into the descent."
      }
    ],
    "safety": {
      "precautions": [
        "Ensure adequate floor space and good shoe traction to prevent slipping when kicking legs back."
      ],
      "spotter": "not-needed"
    }
  },
