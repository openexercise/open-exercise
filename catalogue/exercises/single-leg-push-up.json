  "id": "oec:single-leg-push-up",
  "instructions": {
    "setup": [
      "Assume a standard high plank position with your hands placed directly under or slightly wider than your shoulders and your fingers spread.",
      "Position your feet hip-width apart and establish a rigid line from your head to your heels.",
      "Lift one foot several inches off the floor while keeping that leg straight, toes pointed toward the floor, and hips level."
    ],
    "steps": [
      "Inhale and lower your chest toward the floor by bending your elbows back at roughly a 45-degree angle to your torso.",
      "Descend until your chest is just above the floor while resisting any twisting or dipping of the hips.",
      "Exhale and press through your palms to return to the starting plank position with full elbow extension.",
      "Complete the desired repetitions, then switch legs."
    ],
    "breathing": "Inhale smoothly as you lower your body and exhale forcefully as you press back up.",
    "cues": [
      "Keep hips square to the floor",
      "Glute tight on the elevated leg",
      "Push the floor away at the top"
    ],
    "common_faults": [
      {
        "fault": "Rotating the hips toward the elevated leg.",
        "correction": "Squeeze your core and keep both hip bones facing directly down toward the floor throughout the movement."
      },
      {
        "fault": "Lifting the raised leg too high and arching the lower back.",
        "correction": "Only raise the foot a few inches off the floor, engaging the glute without extending the lumbar spine."
      }
    ],
    "safety": {
      "precautions": [
        "Maintain core tension to protect the lower back from hyperextension under rotational torque."
      ],
      "spotter": "not-needed"
    }
  },
