  "instructions": {
    "setup": [
      "Sit on the floor with your legs fully extended in front of you and feet together.",
      "Place your palms flat on the floor alongside your hips, fingers pointing forward or slightly outward."
    ],
    "steps": [
      "Drive down firmly through your hands to depress your shoulders and lift your pelvis and thighs off the floor.",
      "Keep your heels resting lightly on the ground to provide balance and take a small amount of weight off your core and hip flexors.",
      "Lock your elbows out completely and brace your abdominal wall to maintain hip elevation.",
      "Hold the elevated isometric position for the desired duration, then gently lower your hips back to the floor."
    ],
    "breathing": "Breathe shallowly and steadily through the diaphragm while maintaining deep abdominal tension.",
    "cues": [
      "Push the floor away",
      "Lock the elbows",
      "Keep the heels light",
      "Chest tall and shoulders down"
    ],
    "common_faults": [
      {
        "fault": "Shrugging the shoulders up toward the ears.",
        "correction": "Actively press downward into the floor to depress the scapulae and create space between your shoulders and ears."
      },
      {
        "fault": "Bearing too much weight through the heels.",
        "correction": "Engage the hip flexors and abs to lift as much leg weight as possible, using the heels only for light balance assistance."
      },
      {
        "fault": "Soft or bent elbows during the hold.",
        "correction": "Fully extend and lock out your arms to support your bodyweight structurally through your skeleton."
      }
    ],
    "safety": {
      "precautions": [
        "If wrist mobility or discomfort is limiting on the flat floor, use parallettes, push-up handles, or yoga blocks."
      ],
      "spotter": "not-needed"
    }
  },
