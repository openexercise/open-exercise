  "instructions": {
    "setup": [
      "Sit with your back against the pad and grip the handles at your sides, elbows bent and pointing back."
    ],
    "steps": [
      "Press the handles down until your arms are straight, keeping your shoulders down and back.",
      "Let the handles rise under control until your elbows are bent to about 90 degrees, then press again."
    ],
