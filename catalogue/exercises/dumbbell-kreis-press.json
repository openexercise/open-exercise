  "instructions": {
    "setup": [
      "Adjust an incline bench to roughly 45 degrees.",
      "Sit back firmly against the pad with feet flat on the floor, holding a dumbbell in each hand at shoulder height with palms facing forward or slightly inward."
    ],
    "steps": [
      "Press the dumbbells overhead until your arms are fully extended.",
      "Lower the dumbbells under control back to shoulder level.",
      "Rotate your forearms into a supinated position (palms facing up) and extend your arms forward away from your chest.",
      "Bring the dumbbells together in front of you at chest height with arms nearly straight.",
      "Reverse the motion by drawing the elbows back to shoulder height, rotating palms forward, and pressing overhead into the next rep."
    ],
    "breathing": "Inhale as you lower the weights and reach forward; exhale forcefully as you drive the dumbbells overhead.",
    "cues": [
      "Control the reach forward",
      "Keep tension in the front delts",
      "Smooth rotation at the shoulders"
    ],
    "common_faults": [
      {
        "fault": "Using excessively heavy weight that compromises the straight-arm reach phase.",
        "correction": "Select lighter dumbbells than standard overhead presses to protect the anterior shoulder capsule."
      },
      {
        "fault": "Excessive arching of the lower back away from the bench.",
        "correction": "Keep your core braced and maintain contact between your lower back and the backrest throughout the movement."
      }
    ],
    "safety": {
      "precautions": [
        "Avoid letting the dumbbells drop rapidly during the forward extension phase.",
        "Discontinue if experiencing acute anterior shoulder impingement."
      ],
      "spotter": "not-needed"
    }
  },
