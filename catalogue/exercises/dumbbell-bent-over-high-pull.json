  "instructions": {
    "setup": [
      "Stand with your feet hip-width apart, holding a dumbbell in each hand using an overhand (pronated) grip.",
      "Hinge at your hips with a slight bend in your knees, lowering your torso until it is roughly 45 degrees to the floor while maintaining a flat back.",
      "Let the dumbbells hang naturally below your shoulders with arms fully extended."
    ],
    "steps": [
      "Initiate the pull by driving your elbows up and out wide to the sides.",
      "Pull the dumbbells toward your upper chest, keeping your elbows higher than your wrists throughout the ascent.",
      "Squeeze your shoulder blades together at the top of the motion for a brief pause.",
      "Lower the dumbbells under control back to the starting hanging position."
    ],
    "breathing": "Exhale as you pull the dumbbells up toward your chest; inhale as you lower them with control.",
    "cues": [
      "Lead with the elbows high and wide.",
      "Pinch your shoulder blades at the top.",
      "Keep your torso still and brace your core."
    ],
    "common_faults": [
      {
        "fault": "Using excessive body English or standing up to heave the weights.",
        "correction": "Reduce the dumbbell weight and keep your hip hinge stationary throughout the set."
      },
      {
        "fault": "Pulling elbows in close to the torso like a standard row.",
        "correction": "Flare your elbows out wide perpendicular to your torso to target the upper back and rear delts."
      },
      {
        "fault": "Rounding the lower back.",
        "correction": "Maintain an active hip hinge with an engaged core and neutral spine."
      }
    ],
    "safety": {
      "precautions": [
        "Avoid using excessively heavy loads that compromise lumbar spinal alignment."
      ],
      "spotter": "not-needed"
    }
  },
