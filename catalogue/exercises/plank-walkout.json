  "id": "oec:plank-walkout",
  "instructions": {
    "setup": [
      "Stand upright with your feet hip-width apart and arms relaxed at your sides.",
      "Soften your knees slightly, hinge forward at the hips, and place both hands flat on the floor in front of your feet."
    ],
    "steps": [
      "Walk your hands forward one at a time in small, controlled steps.",
      "Pass through a standard push-up position and continue walking your hands forward into an extended plank as far as your core can stably control.",
      "Squeeze your glutes and brace your abdominals tightly to prevent your lower back from arching or hips from sagging.",
      "Pause for a brief moment at peak extension.",
      "Carefully walk your hands backward one step at a time toward your feet.",
      "Either remain in the hinged position to start the next repetition or stand fully upright to complete the rep."
    ],
    "breathing": "Exhale as you walk your hands out to maximal extension, and breathe steadily in shallow sips without releasing abdominal tension.",
    "cues": [
      "Ribs to hips",
      "Squeeze glutes tight",
      "Small steps with hands"
    ],
    "common_faults": [
      {
        "fault": "Hyperextending the lumbar spine as hands walk far forward.",
        "correction": "Walk out only as far as you can maintain a rigid, neutral pelvis and braced abdomen."
      },
      {
        "fault": "Excessive hip sway side-to-side during hand steps.",
        "correction": "Widen your foot stance slightly and brace your core to resist torso rotation."
      }
    ],
    "safety": {
      "precautions": [
        "Individuals with wrist discomfort may perform the movement on fists or elevate hands slightly on push-up handles."
      ],
      "spotter": "not-needed"
    }
  },
