  "id": "oec:bear-plank-pull-through",
  "instructions": {
    "setup": [
      "Set up on hands and knees with hands directly under shoulders and knees directly under hips.",
      "Place a dumbbell or kettlebell on the floor just behind your supporting hand on one side.",
      "Tuck your toes and press through the floor to elevate your knees one to two inches off the ground into a bear plank."
    ],
    "steps": [
      "Brace your core and reach your opposite hand across your body beneath your chest to grasp the weight.",
      "Drag or lift the weight smoothly across the floor until it clears the outside of your supporting hand on the other side.",
      "Return the reaching hand to the floor under your shoulder to re-establish your four-point support.",
      "Reach across with the opposite hand and pull the weight back to the starting side, alternating repetitions while keeping your hips level."
    ],
    "breathing": "Maintain steady, rhythmic breathing throughout, exhaling during the pull phase without releasing abdominal pressure.",
    "cues": [
      "Knees low, hovering just off the floor.",
      "Do not let the hips sway or rotate.",
      "Push the floor away with the grounded arm."
    ],
    "common_faults": [
      {
        "fault": "Piking the hips into the air like a downward dog.",
        "correction": "Keep knees bent at 90 degrees and floating only an inch or two above the floor."
      },
      {
        "fault": "Excessive rocking and hip rotation from side to side.",
        "correction": "Widen your foot stance slightly and brace your torso firmly to resist rotation as your hand leaves the ground."
      }
    ],
    "safety": {
      "precautions": [
        "Ensure your wrist is positioned directly beneath your shoulder to minimize joint strain while supporting weight single-armed."
      ],
      "spotter": "not-needed"
    }
  },
