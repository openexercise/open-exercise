  "id": "oec:dumbbell-multi-planar-lunge",
  "instructions": {
    "setup": [
      "Stand tall with feet hip-width apart, holding a light dumbbell in each hand at your sides with a neutral grip.",
      "Brace your core, draw your shoulders slightly back, and fix your gaze straight ahead."
    ],
    "steps": [
      "Step forward into a front lunge, lowering until your back knee hovers just off the floor, then push forcefully back to the starting position.",
      "Step directly out to the side into a lateral lunge, sitting your hips back over the working heel while keeping the trailing leg straight, then drive back to center.",
      "Step backward at a diagonal angle into a reverse lunge, descend with control, and push back to the starting stance.",
      "Continue cycling through the target directional sequence, then repeat the pattern on the opposite leg."
    ],
    "breathing": "Inhale as you step out and lower into each lunge; exhale forcefully as you push through your foot to return to standing.",
    "cues": [
      "Chest stays tall",
      "Push the floor away",
      "Knee tracks over toes"
    ],
    "common_faults": [
      {
        "fault": "Allowing the lead knee to cave inward during lateral or diagonal lunges.",
        "correction": "Actively press the knee outward so it tracks in line with your second and third toes."
      },
      {
        "fault": "Rounding the lower back or collapsing the torso forward when lunging.",
        "correction": "Maintain an upright torso by bracing your abdominals and keeping your chest lifted."
      }
    ],
    "safety": {
      "precautions": [
        "Ensure a wide, clear perimeter of floor space in all directions before beginning.",
        "Use light loads to prioritize balance and multi-planar joint control over heavy resistance."
      ],
      "spotter": "not-needed"
    }
  },
