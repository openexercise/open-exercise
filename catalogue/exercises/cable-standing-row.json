  "instructions": {
    "setup": [
      "Set the cable pulley to mid-torso height and attach a handle, such as a close-grip double-D handle or two single handles.",
      "Grasp the handles, step back a few paces to lift the weight stack, and stand facing the machine with feet hip-width apart.",
      "Unlock your knees slightly, brace your abdominal wall, and hold your chest tall with arms fully extended toward the pulley."
    ],
    "steps": [
      "Initiate the pull by retracting your shoulder blades and driving your elbows backward alongside your ribcage.",
      "Pull the handle firmly toward your abdomen or lower sternum until your back muscles are fully contracted.",
      "Pause briefly at peak contraction, keeping your torso stable and upright.",
      "Slowly extend your arms and allow the shoulder blades to protract under control to return to the starting position."
    ],
    "breathing": "Exhale forcefully as you row the handle into your torso; inhale steadily as you extend your arms back out.",
    "cues": [
      "Drive the elbows back.",
      "Keep the chest proud.",
      "Control the stretch without swinging."
    ],
    "common_faults": [
      {
        "fault": "Swinging the torso backward to generate momentum.",
        "correction": "Keep your hips and torso braced in an athletic stance; move only through the shoulders and arms."
      },
      {
        "fault": "Shrugging the shoulders upward during the pull.",
        "correction": "Depress your shoulders down away from your ears before and throughout each rep."
      }
    ],
    "safety": {
      "precautions": [
        "Maintain a stable base of support with soft knees to avoid being pulled forward off balance by the cable tension."
      ],
      "spotter": "not-needed"
    }
  },
