  "id": "oec:lateral-squat-walk",
  "instructions": {
    "setup": [
      "Stand tall with your feet parallel and hip-width apart.",
      "Hinge slightly at the hips and bend your knees to lower into a quarter or half squat.",
      "Keep your chest upright, spine neutral, and hands held together in front of your chest for balance."
    ],
    "steps": [
      "Step laterally to the side with your lead foot, widening your stance while maintaining the squat depth.",
      "Slowly bring the trailing foot inward until feet return to hip-width apart.",
      "Continue stepping in the same direction for the target number of reps or distance, then repeat in the opposite direction."
    ],
    "breathing": "Breathe continuously and rhythmically throughout the set without holding your breath.",
    "cues": [
      "Stay low throughout the entire set",
      "Keep feet pointing straight ahead",
      "Push through the hips, not the lower back"
    ],
    "common_faults": [
      {
        "fault": "Standing up between steps.",
        "correction": "Maintain a constant squat depth without bobbing up and down."
      },
      {
        "fault": "Turning toes outward excessively during lateral steps.",
        "correction": "Keep your toes pointed forward so the lateral glutes remain under active tension."
      },
      {
        "fault": "Letting the feet touch together on the follow-through step.",
        "correction": "Stop the trailing foot when it returns to hip-width apart to maintain continuous hip tension."
      }
    ],
    "safety": {
      "precautions": [
        "Ensure the floor path is completely clear of tripping hazards before stepping sideways."
      ],
      "spotter": "not-needed"
    }
  },
