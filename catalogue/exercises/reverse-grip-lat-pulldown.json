  "instructions": {
    "setup": [
      "Adjust the thigh pad on the lat pulldown machine so your legs are firmly secured with feet flat on the floor.",
      "Grasp the bar with a supinated (underhand) grip at roughly shoulder width.",
      "Sit down under the pads, fully extend your arms overhead, and establish a slight backward lean through your upper torso while keeping your core braced."
    ],
    "steps": [
      "Initiate the movement by depressing your shoulder blades and pulling your elbows down and in toward your ribs.",
      "Draw the bar down in a controlled path until it lightly touches or nears your upper chest.",
      "Pause briefly at the bottom while actively squeezing your lats.",
      "Slowly reverse the motion, extending your arms and allowing your shoulder blades to upwardly rotate until you reach a full overhead stretch."
    ],
    "breathing": "Exhale as you pull the bar down toward your chest, and inhale as you return it smoothly overhead.",
    "cues": [
      "Lead with the elbows, not your hands.",
      "Chest up to meet the bar.",
      "Control the stretch at the top."
    ],
    "common_faults": [
      {
        "fault": "Excessive backward leaning to use momentum.",
        "correction": "Maintain a fixed, subtle torso lean of roughly 10 to 15 degrees throughout the entire rep."
      },
      {
        "fault": "Cutting the range of motion short at the top.",
        "correction": "Allow the arms to fully straighten overhead to achieve a complete stretch in the lats before initiating the next repetition."
      },
      {
        "fault": "Pulling the bar too low toward the abdomen.",
        "correction": "Target the upper-to-mid chest; pulling lower forces internal shoulder rotation and reduces lat engagement."
      }
    ],
    "safety": {
      "precautions": [
        "Ensure the thigh pads are locked securely before selecting working loads."
      ],
      "spotter": "not-needed"
    }
  },
