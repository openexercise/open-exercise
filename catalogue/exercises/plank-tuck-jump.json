  "id": "oec:plank-tuck-jump",
  "instructions": {
    "setup": [
      "Assume a high plank position on the floor with your hands directly under your shoulders.",
      "Extend your legs straight back with your feet hip-width apart, establishing a rigid straight line from head to heels."
    ],
    "steps": [
      "Brace your core and jump both feet forward simultaneously, bending your knees to tuck them toward your chest.",
      "Land lightly on the balls of your feet under your hips.",
      "Immediately push off the ground to jump both feet back to the starting plank position.",
      "Re-establish a neutral spine and core tension momentarily before initiating the next repetition."
    ],
    "breathing": "Exhale forcefully as you tuck your knees toward your chest, and inhale as you jump your feet back into the plank.",
    "cues": [
      "Push the floor away through your shoulders.",
      "Stay light on your toes.",
      "Don't let your hips sag on the return."
    ],
    "common_faults": [
      {
        "fault": "Allowing the hips to drop and hyperextending the lower back when kicking out.",
        "correction": "Squeeze the glutes and brace the abdominals to catch yourself in a solid neutral plank."
      },
      {
        "fault": "Shifting shoulders backward behind the wrists during the jump.",
        "correction": "Keep your shoulders stacked directly over or slightly ahead of your hands throughout the movement."
      }
    ],
    "safety": {
      "precautions": [
        "Ensure the floor surface is non-slip to prevent your hands or feet from sliding during the impact."
      ],
      "spotter": "not-needed"
    }
  },
