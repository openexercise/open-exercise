  "instructions": {
    "setup": [
      "Kneel on the floor facing a flat bench or box, placing a mat under your knees if needed for comfort.",
      "Place both elbows shoulder-width apart on the edge of the bench with your palms pressed together or holding a light dowel."
    ],
    "steps": [
      "Shift your hips back toward your heels while allowing your head and chest to drop between your arms toward the floor.",
      "Bend your elbows deeply to bring your hands back toward the base of your neck or upper back.",
      "Hold the position while maintaining deep, controlled breathing, feeling the stretch through the lats, triceps, and upper back.",
      "Carefully lift your chest and bring your hands forward to release the tension."
    ],
    "breathing": "Breathe slowly and deeply through your nose, using each exhalation to sink gently deeper into the stretch without forcing it.",
    "cues": [
      "Sink chest toward the floor",
      "Elbows stay fixed on the bench",
      "Thumbs reach for your upper back",
      "Lengthen your spine without arching your lower back"
    ],
    "common_faults": [
      {
        "fault": "Excessively arching the lower back to compensate for stiff shoulders.",
        "correction": "Brace your core gently and keep your ribcage down, focusing extension through the mid-to-upper back."
      },
      {
        "fault": "Allowing elbows to flare excessively wide.",
        "correction": "Maintain elbows at shoulder width throughout the hold to keep the stretch centered on the lats and triceps."
      }
    ],
    "safety": {
      "precautions": [
        "Discontinue the stretch if you experience sharp anterior shoulder impingement or pain."
      ],
      "spotter": "not-needed"
    }
  },
