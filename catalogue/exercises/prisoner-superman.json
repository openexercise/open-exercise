  "id": "oec:prisoner-superman",
  "instructions": {
    "setup": [
      "Lie face down on a mat with your legs extended straight behind you.",
      "Place your hands behind your head with fingers lightly touching or interlaced, pointing your elbows out wide to the sides."
    ],
    "steps": [
      "Engage your glutes and core to anchor your lower body against the floor.",
      "Contract your spinal erectors and upper back to lift your chest and upper ribs off the floor.",
      "Simultaneously draw your elbows upward toward the ceiling, actively retracting your shoulder blades.",
      "Hold the contraction at the top for a brief pause while keeping your neck neutral.",
      "Lower your chest and upper body slowly back to the starting position."
    ],
    "breathing": "Exhale as you raise your chest and elbows off the floor; inhale as you lower with control.",
    "cues": [
      "Lead with the chest, not the chin",
      "Pull elbows toward the ceiling",
      "Keep eyes focused down at the mat"
    ],
    "common_faults": [
      {
        "fault": "Pulling on the back of the neck with the hands, causing excessive cervical flexion or strain.",
        "correction": "Rest fingertips lightly against the temples or occiput without pulling on the head."
      },
      {
        "fault": "Hyperextending the neck by looking straight ahead or upward.",
        "correction": "Maintain a packed neck and keep your gaze directed at the floor throughout the repetition."
      }
    ],
    "safety": {
      "precautions": [
        "Avoid forceful spinal hyperextension if experiencing acute lower back irritation."
      ],
      "spotter": "not-needed"
    }
  },
