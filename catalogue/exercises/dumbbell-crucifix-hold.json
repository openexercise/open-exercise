  "instructions": {
    "setup": [
      "Stand tall with feet shoulder-width apart, holding a dumbbell in each hand at your sides.",
      "Brace your core, squeeze your glutes, and retract your shoulder blades slightly."
    ],
    "steps": [
      "Raise the dumbbells straight out to your sides until your arms are parallel to the floor, forming a T-shape with your body.",
      "Lock your elbows with only a slight microbend and keep your wrists straight.",
      "Hold this position statically for the prescribed duration while maintaining a rigid torso.",
      "Lower the weights smoothly back to your sides under control when the set is complete."
    ],
    "breathing": "Maintain steady, rhythmic breathing throughout the hold without letting your ribs flare or bracing drop.",
    "cues": [
      "Reach long through your knuckles",
      "Stay tall and do not lean back",
      "Keep shoulders down away from your ears"
    ],
    "common_faults": [
      {
        "fault": "Hyperextending the lower back to keep the weights elevated.",
        "correction": "Brace your abdominal muscles and squeeze your glutes to maintain a neutral spine."
      },
      {
        "fault": "Allowing the arms to sag below parallel.",
        "correction": "End the set once you can no longer keep your arms at shoulder height, or reduce the dumbbell weight."
      },
      {
        "fault": "Excessively shrugging the shoulders upward.",
        "correction": "Depress your scapulae and focus on driving the hold through the side deltoids."
      }
    ],
    "safety": {
      "precautions": [
        "Start with very light weights, as the long lever arm creates high torque at the shoulder joint."
      ],
      "spotter": "not-needed"
    }
  },
