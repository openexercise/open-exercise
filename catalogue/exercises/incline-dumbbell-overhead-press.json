  "id": "oec:incline-dumbbell-overhead-press",
  "instructions": {
    "setup": [
      "Set an adjustable bench to an incline (around 45 to 60 degrees).",
      "Sit back firmly against the pad with feet flat on the floor.",
      "Bring the dumbbells to shoulder height, with elbows angled forward at roughly 45 degrees in the scapular plane and palms facing forward or slightly inward."
    ],
    "steps": [
      "Press the dumbbells upward along a natural arc until your arms are fully extended overhead without clanging the weights together.",
      "Lower the dumbbells in a controlled motion until your upper arms are approximately parallel to your shoulders or you feel a comfortable stretch in your deltoids.",
      "Pause briefly at the bottom before initiating the next repetition."
    ],
    "breathing": "Inhale as you lower the dumbbells to shoulder level, and exhale forcefully as you press them overhead.",
    "cues": [
      "Press up and slightly back.",
      "Keep elbows tucked slightly inside the shoulders.",
      "Drive your feet into the floor."
    ],
    "common_faults": [
      {
        "fault": "Flaring the elbows straight out to the sides.",
        "correction": "Tuck the elbows roughly 30 to 45 degrees into the scapular plane to protect the shoulder joints."
      },
      {
        "fault": "Excessively arching the lower back off the bench.",
        "correction": "Brace your core and keep your lower back flush against the back support."
      },
      {
        "fault": "Banging the dumbbells together at lockout.",
        "correction": "Press in a smooth upward path and stop just before the weights touch."
      }
    ],
    "safety": {
      "precautions": [
        "Do not drop heavy dumbbells from the top position; bring them back to your knees before standing up."
      ],
      "spotter": "recommended"
    }
  },
