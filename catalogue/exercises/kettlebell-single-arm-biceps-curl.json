  "instructions": {
    "setup": [
      "Stand tall with feet hip-width apart and your core braced.",
      "Hold a kettlebell by the handle in one hand with your arm extended down at your side, palm facing forward or slightly inward."
    ],
    "steps": [
      "Keep your upper arm pinned close to your torso and flex at the elbow to curl the kettlebell upward.",
      "Contract your biceps firmly at the top of the movement as the weight approaches shoulder height.",
      "Lower the kettlebell in a controlled arc back to full elbow extension."
    ],
    "breathing": "Exhale as you curl the kettlebell upward and inhale as you lower it with control.",
    "cues": [
      "Pin your elbow to your side",
      "Do not swing your hips",
      "Control the kettlebell on the way down"
    ],
    "common_faults": [
      {
        "fault": "Swinging the torso to create momentum to move the weight.",
        "correction": "Brace your core and stay completely upright, choosing a lighter kettlebell if necessary."
      },
      {
        "fault": "Allowing the elbow to drift excessively forward during the lift.",
        "correction": "Keep your upper arm vertical and stationary beside your ribs throughout the repetition."
      }
    ],
    "safety": {
      "precautions": [
        "Maintain a neutral wrist to prevent excessive strain from the off-center mass of the kettlebell."
      ],
      "spotter": "not-needed"
    }
  },
