  "instructions": {
    "setup": [
      "Stand tall with your feet shoulder-width apart and your arms resting naturally at your sides.",
      "Brace your core lightly and keep your chest lifted with shoulders relaxed."
    ],
    "steps": [
      "Raise both arms out to the sides in a wide arc until they meet directly over your head.",
      "Clap your palms together firmly at the top of the motion.",
      "Lower your arms back down along the same path under control to the starting position."
    ],
    "breathing": "Breathe rhythmically, inhaling as the arms ascend and exhaling as they descend.",
    "cues": [
      "Keep elbows long but soft",
      "Clap directly overhead",
      "Keep your ribs down and core braced"
    ],
    "common_faults": [
      {
        "fault": "Arching the lower back when reaching overhead.",
        "correction": "Engage your abdominals to keep the ribs anchored and the spine neutral."
      },
      {
        "fault": "Shrugging the shoulders aggressively up into the ears.",
        "correction": "Allow natural scapular upward rotation without excessively tensing the neck."
      }
    ],
    "safety": {
      "precautions": [
        "If you experience shoulder impingement or pain overhead, stop short of full abduction or turn the thumbs upward."
      ],
      "spotter": "not-needed"
    }
  },
