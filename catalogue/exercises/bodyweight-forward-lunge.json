  "id": "oec:bodyweight-forward-lunge",
  "instructions": {
    "setup": [
      "Stand tall with your feet hip-width apart and your toes pointing forward.",
      "Place your hands on your hips or clasp them loosely in front of your chest for balance.",
      "Engage your core and maintain an upright posture with your shoulders back."
    ],
    "steps": [
      "Take a controlled step forward with one leg, keeping your feet aligned with your hips.",
      "Lower your hips straight down until both knees are bent to approximately 90 degrees and the back knee hovers just above the floor.",
      "Push firmly through the heel and midfoot of your lead leg to drive back up to the starting position.",
      "Complete all repetitions on one side before switching, or alternate legs as programmed."
    ],
    "breathing": "Inhale as you step forward and lower into the lunge, and exhale forcefully as you press back to the starting position.",
    "cues": [
      "Stay on train tracks, not a tightrope.",
      "Drop straight down rather than leaning forward.",
      "Keep the front heel glued to the floor."
    ],
    "common_faults": [
      {
        "fault": "Stepping with feet directly in line, leading to loss of balance.",
        "correction": "Maintain hip-width spacing between your left and right feet throughout the stride."
      },
      {
        "fault": "Letting the front heel lift off the ground as the knee drifts excessively forward.",
        "correction": "Take a slightly longer stride and focus on keeping pressure centered over the front midfoot and heel."
      },
      {
        "fault": "Collapsing the front knee inward (valgus collapse) during descent or ascent.",
        "correction": "Actively track the front kneecap over the second toe throughout the movement."
      }
    ],
    "safety": {
      "precautions": [
        "Avoid forcefully slamming the trailing knee into the floor; lower with control."
      ],
      "spotter": "not-needed"
    }
  },
