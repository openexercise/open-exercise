  "instructions": {
    "setup": [
      "Stand upright with your feet together and your arms resting naturally at your sides.",
      "Engage your core and keep your chest lifted with a soft bend in your knees."
    ],
    "steps": [
      "Jump lightly off the balls of your feet, spreading your legs out wider than shoulder-width.",
      "Simultaneously sweep your arms out to the sides and overhead until your hands meet or nearly touch above your head.",
      "Immediately jump again to return your feet together while bringing your arms back down to your sides.",
      "Land softly on the balls of your feet and transition smoothly into the next repetition."
    ],
    "breathing": "Maintain a steady, rhythmic breathing pattern, inhaling and exhaling continuously in time with your jumps.",
    "cues": [
      "Stay light on your feet",
      "Soft knees on every landing",
      "Clap at the top"
    ],
    "common_faults": [
      {
        "fault": "Landing flat-footed with straight, locked knees, sending impact through the joints.",
        "correction": "Stay on the balls of your feet and maintain a slight, springy bend in your knees throughout."
      },
      {
        "fault": "Flailing the arms with incomplete range of motion.",
        "correction": "Bring your hands all the way overhead in a controlled, wide arc on each repetition."
      }
    ],
    "safety": {
      "precautions": [
        "Wear supportive footwear and perform on a level, non-slip surface to reduce impact stress on the lower legs."
      ],
      "spotter": "not-needed"
    }
  },
