  "id": "oec:standing-i-y-t-raise",
  "instructions": {
    "setup": [
      "Stand tall with feet hip-width apart and knees soft.",
      "Brace your core, draw your ribs down, and let your arms hang naturally at your sides with thumbs pointing forward."
    ],
    "steps": [
      "Raise both arms directly forward and overhead into an 'I' position until fully elevated, then lower with control to your sides.",
      "Raise both arms at roughly a 45-degree angle from your torso into a 'Y' position with thumbs pointing up and back, then lower smoothly.",
      "Raise both arms directly out to the sides into a 'T' position until parallel with the floor, squeezing your shoulder blades together, then return to the starting position."
    ],
    "breathing": "Inhale as you raise your arms in each direction to support thoracic extension, and exhale as you lower them.",
    "cues": [
      "Lead with your thumbs.",
      "Keep shoulders down away from your ears.",
      "Do not arch your lower back."
    ],
    "common_faults": [
      {
        "fault": "Hyperextending the lumbar spine to gain overhead range of motion.",
        "correction": "Keep your abdominals braced and ribcage pulled down throughout all three positions."
      },
      {
        "fault": "Shrugging the upper traps excessively during the raises.",
        "correction": "Focus on depressing your scapulae and lifting via mid and lower trap activation rather than shrugging."
      }
    ],
    "safety": {
      "precautions": [
        "Move through a pain-free range of motion if you experience shoulder impingement."
      ],
      "spotter": "not-needed"
    }
  },
