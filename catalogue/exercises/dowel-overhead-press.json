  "id": "oec:dowel-overhead-press",
  "instructions": {
    "setup": [
      "Stand tall with feet hip-width apart and knees soft.",
      "Grip a wooden dowel or PVC pipe with an overhand grip slightly wider than shoulder width.",
      "Rest the dowel across your clavicles in front of your neck, bracing your core and keeping your ribcage down."
    ],
    "steps": [
      "Press the dowel straight up overhead until your elbows are fully locked out and the dowel aligns with your ears.",
      "Smoothly lower the dowel behind your neck toward your upper trapezius, moving only through a pain-free range of motion.",
      "Press the dowel back up to full lockout overhead.",
      "Lower the dowel back to the starting position in front of your chest."
    ],
    "breathing": "Exhale as you press overhead, and inhale smoothly as you lower the dowel.",
    "cues": [
      "Keep ribs down and core braced",
      "Reach tall at lockout",
      "Never force uncomfortable range behind the neck"
    ],
    "common_faults": [
      {
        "fault": "Overarching the lower back to force overhead mobility.",
        "correction": "Squeeze the glutes and pull the lower ribs down toward the pelvis throughout the movement."
      },
      {
        "fault": "Forcing the dowel too deep behind the head.",
        "correction": "Widen your grip slightly or lower only as far as shoulder mobility allows comfortably."
      }
    ],
    "safety": {
      "precautions": [
        "Avoid forced behind-the-neck movements if experiencing active shoulder impingement or pain."
      ],
      "spotter": "not-needed"
    }
  },
