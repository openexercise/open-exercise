  "id": "oec:barbell-step-up",
  "instructions": {
    "setup": [
      "Set up a sturdy box or bench roughly at knee height in front of you.",
      "Unrack a barbell across your upper traps in a high-bar position and take a stable standing posture facing the box."
    ],
    "steps": [
      "Place your lead foot firmly and fully on top of the box.",
      "Drive through the midfoot and heel of the lead leg to extend your hip and knee, lifting your body upward.",
      "Step onto the box without pushing off excessively with the trailing foot.",
      "Briefly reach full extension at the top while maintaining your balance.",
      "Lower your trailing foot under control back to the floor, keeping the working leg loaded until you touch down."
    ],
    "breathing": "Inhale and brace your core before stepping up; exhale once standing tall on the box.",
    "cues": [
      "Drive through the front heel",
      "Do not bounce off the back calf",
      "Stay tall through the torso"
    ],
    "common_faults": [
      {
        "fault": "Pushing off heavily with the trailing foot on the floor.",
        "correction": "Dorsiflex the back ankle and drive almost all effort through the front leg."
      },
      {
        "fault": "Excessive forward torso collapse during the ascent.",
        "correction": "Keep your chest proud and upper back tightly braced against the barbell."
      },
      {
        "fault": "Using a platform that is excessively high, compromising pelvic alignment.",
        "correction": "Choose a box height where your hip crease does not sit excessively below your knee at the start."
      }
    ],
    "safety": {
      "precautions": [
        "Ensure the box or step is completely stable and will not tip over.",
        "Clear the floor around you to prevent tripping during descent."
      ],
      "spotter": "recommended"
    }
  },
