  "instructions": {
    "setup": [
      "Stand upright with your feet shoulder-width apart and your arms at your sides."
    ],
    "steps": [
      "Hinge at the hips and bend your knees to place your hands flat on the floor directly beneath your shoulders.",
      "Jump or step both feet back into a full plank position.",
      "Lower your chest and thighs completely to the floor under control.",
      "Press through your palms to push your body up while snapping your feet forward outside your hands into a low squat.",
      "Explode upward into a vertical jump, reaching your hands overhead, and land softly to absorb impact."
    ],
    "breathing": "Inhale as you drop down to the floor, exhale forcefully as you press up and jump.",
    "cues": [
      "Hands down, feet back.",
      "Chest to floor.",
      "Snap the hips forward.",
      "Jump and reach tall."
    ],
    "common_faults": [
      {
        "fault": "Sagging the lower back and hyperextending the spine while pushing off the floor.",
        "correction": "Brace your core firmly to keep your torso rigid as you press up from the ground."
      },
      {
        "fault": "Landing flat-footed with straight knees after the jump.",
        "correction": "Absorb the landing softly on the balls of your feet and immediately bend your knees."
      }
    ],
    "safety": {
      "precautions": [
        "Ensure the floor surface is clear and non-slip before performing rapid jumps."
      ],
