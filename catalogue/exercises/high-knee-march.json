  "instructions": {
    "setup": [
      "Stand tall with your feet hip-width apart and your toes pointing straight ahead.",
      "Engage your core, pull your shoulders back and down, and let your arms hang naturally at your sides with elbows bent at roughly ninety degrees."
    ],
    "steps": [
      "Drive one knee up toward your chest until your thigh is parallel to the floor or slightly higher, keeping the foot dorsiflexed.",
      "Simultaneously pump the opposite arm forward and the same-side arm backward in a natural running motion.",
      "Lower the lifted foot under control back to the starting position.",
      "Immediately repeat the motion with the opposite leg and arm, establishing a smooth, rhythmic marching cadence."
    ],
    "breathing": "Maintain a steady, rhythmic breathing pattern synchronized with your steps, exhaling as each knee reaches top height.",
    "cues": [
      "Stand tall through the supporting hip.",
      "Knee up, toes up.",
      "Pump opposite arm and knee."
    ],
    "common_faults": [
      {
        "fault": "Leaning back as the knee is raised to compensate for limited hip flexor mobility.",
        "correction": "Brace the abdominal wall and lift the knee only as high as you can maintain a vertical torso."
      },
      {
        "fault": "Allowing the foot to point downward during the lift.",
        "correction": "Actively pull your toes up toward your shin as your knee ascends."
      },
      {
        "fault": "Stomping the foot heavily onto the ground.",
        "correction": "Land softly on the midfoot and control the descent of each leg."
      }
    ],
    "safety": {
      "precautions": [
        "If balance is compromised, perform the drill near a wall or sturdy bar for light hand support."
      ],
      "spotter": "not-needed"
    }
  },
