  "instructions": {
    "setup": [
      "Set an adjustable bench to a moderate incline (around 45 to 60 degrees).",
      "Hold a dumbbell in each hand with a neutral grip (palms facing inward).",
      "Lie chest-down against the incline pad with your feet firmly planted on the floor.",
      "Pull your elbows up and back alongside your torso until your upper arms are roughly parallel to your torso."
    ],
    "steps": [
      "Keep your upper arms locked in place and extend your elbows, pressing the dumbbells backward.",
      "Contract your triceps firmly at the top of the movement when your arms reach full extension.",
      "Lower the dumbbells under control back to a 90-degree elbow bend without letting your upper arms drop."
    ],
    "breathing": "Exhale as you extend your elbows back; inhale as you return the dumbbells to the starting position.",
    "cues": [
      "Pin your elbows to your sides",
      "Only move the forearms",
      "Squeeze your triceps at the lockout"
    ],
    "common_faults": [
      {
        "fault": "Swinging the upper arms forward and back to gain momentum.",
        "correction": "Lock your upper arms stationary against your ribs so only your forearms hinge at the elbow."
      },
      {
        "fault": "Dropping the elbows below torso level during the set.",
        "correction": "Engage your rear delts and upper back to hold your elbows high throughout the entire range of motion."
      }
    ],
    "safety": {
      "precautions": [
        "Use moderate to light weights to avoid excessive strain on the shoulder joint and elbow tendon."
      ],
      "spotter": "not-needed"
    }
  },
