  "id": "oec:vertical-leg-crunch",
  "instructions": {
    "setup": [
      "Lie flat on your back on a mat.",
      "Raise your legs straight up toward the ceiling so your hips are flexed at approximately ninety degrees.",
      "Extend your arms upward toward your feet or place your fingertips lightly behind your ears without pulling on your neck."
    ],
    "steps": [
      "Contract your abdominals to curl your upper torso upward, lifting your shoulder blades off the floor.",
      "Reach your hands toward your toes or ankles at the peak of the contraction.",
      "Pause briefly at the top to fully squeeze the abdominals.",
      "Lower your upper back smoothly toward the floor under control without letting your lower back arch or legs drop."
    ],
    "breathing": "Exhale as you curl up and reach toward your feet; inhale as you lower back down.",
    "cues": [
      "Ribs to hips.",
      "Reach up, not forward.",
      "Keep legs steady over hips."
    ],
    "common_faults": [
      {
        "fault": "Swinging the legs back and forth to generate momentum.",
        "correction": "Keep the hips stacked at ninety degrees and hold the legs motionless throughout the movement."
      },
      {
        "fault": "Pulling on the head and yanking the cervical spine.",
        "correction": "Keep the neck neutral with the chin slightly tucked, focusing on lifting the chest with the abdominals."
      }
    ],
    "safety": {
      "precautions": [
        "Maintain a slight bend in the knees if tight hamstrings prevent holding the legs perpendicular to the floor."
      ],
      "spotter": "not-needed"
    }
  },
