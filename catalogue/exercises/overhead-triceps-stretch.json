  "id": "oec:overhead-triceps-stretch",
  "instructions": {
    "setup": [
      "Stand or sit tall with your spine neutral and shoulders relaxed.",
      "Raise one arm overhead and bend at the elbow, dropping your palm down toward the center of your upper back."
    ],
    "steps": [
      "Reach overhead with your opposite hand and grasp the raised elbow.",
      "Gently pull the elbow back and slightly inward until you feel a comfortable stretch along the back of your upper arm.",
      "Hold the position steadily without bouncing.",
      "Release carefully and repeat on the opposite arm."
    ],
    "breathing": "Breathe smoothly and deeply, using each exhalation to relax deeper into the stretch.",
    "cues": [
      "Stand tall through your crown",
      "Keep your ribs down",
      "Gently guide the elbow, never force it"
    ],
    "common_faults": [
      {
        "fault": "Arching the lower back to force the arm further overhead.",
        "correction": "Keep your core gently braced and ribs drawn down to maintain a neutral spine."
      },
      {
        "fault": "Pushing the head and neck forward.",
        "correction": "Keep your chin slightly tucked and your head aligned over your shoulders."
      }
    ],
    "safety": {
      "precautions": [
        "Avoid aggressive downward pulling if you have shoulder impingement or elbow discomfort."
      ],
      "spotter": "not-needed"
    }
  },
