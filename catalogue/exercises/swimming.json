  "instructions": {
    "setup": [
      "Enter the pool and prepare at the wall or on the starting block.",
      "Push off into a streamlined prone glide with your core engaged, hips high near the surface, and head aligned neutrally with your spine."
    ],
    "steps": [
      "Reach forward with one hand entering fingertips-first, initiating a high-elbow catch and pulling water firmly backward toward your hips.",
      "Push past your hip to complete the stroke, then relax the arm as it recovers smoothly over the surface back toward the front.",
      "Alternate continuously with the opposite arm while maintaining a rhythmic, narrow flutter kick initiated from the hips.",
      "Rotate your torso along your long axis with each stroke, turning your head to the side inside the bow wave to inhale before rotating face-down to exhale."
    ],
    "breathing": "Exhale continuously underwater through your nose and mouth, turning your head smoothly to the side to inhale quickly when your mouth clears the surface.",
    "cues": [
      "Reach long and rotate",
      "High elbow on the catch",
      "Kick from the hips, not the knees",
      "Stay streamlined like a torpedo"
    ],
    "common_faults": [
      {
        "fault": "Lifting the head forward to breathe, which forces the hips and legs downward and creates drag.",
        "correction": "Rotate your entire body and roll your head sideways into the breathing pocket, keeping one goggle lens submerged."
      },
      {
        "fault": "Bending the knees excessively during the kick (bicycling).",
        "correction": "Keep your legs relatively long and initiate small, rapid flutter kicks from the hips and glutes with relaxed ankles."
      }
    ],
    "safety": {
      "precautions": [
        "Only swim in safe, supervised pools or designated areas with a lifeguard or swim partner.",
        "Ensure adequate water depth before performing starts, dives, or aggressive push-offs."
      ],
      "spotter": "not-needed"
    }
  },
