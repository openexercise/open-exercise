  "instructions": {
    "setup": [
      "Set the cable pulley to roughly shoulder or upper-chest height.",
      "Grasp the cable end or rubber stopper with a neutral grip using the opposite hand, reaching across your body.",
      "Step slightly away from the stack into a stable staggered stance so the cable is under tension with your upper arm aligned with the line of pull."
    ],
    "steps": [
      "Fix your upper arm in place across your body and brace your core.",
      "Extend your elbow smoothly outward and downward across your body until your arm is fully straightened.",
      "Pause and squeeze the triceps contraction for a brief moment.",
      "Control the weight back across your torso to full elbow flexion before beginning the next repetition."
    ],
    "breathing": "Exhale as you extend the elbow, and inhale as you control the return.",
    "cues": [
      "Keep the upper arm pinned in space.",
      "Hinge entirely at the elbow.",
      "Follow the diagonal angle of the cable."
    ],
    "common_faults": [
      {
        "fault": "Swinging the upper arm or shoulder to initiate movement.",
        "correction": "Lock the shoulder joint in place and ensure only the forearm moves."
      },
      {
        "fault": "Twisting the torso to help move the load.",
        "correction": "Brace the core and maintain a rigid, square torso throughout the set."
      }
    ],
    "safety": {
      "precautions": [
        "Select a load that allows complete control and avoids straining the elbow joint at full extension."
      ],
      "spotter": "not-needed"
    }
  },
