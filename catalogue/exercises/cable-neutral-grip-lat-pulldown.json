  "instructions": {
    "setup": [
      "Attach a neutral-grip handle or parallel-grip bar to the high pulley of a lat pulldown machine.",
      "Adjust the thigh pad so your legs are securely anchored with your feet flat on the floor.",
      "Grasp the handles with palms facing each other and sit down, allowing your arms to extend overhead while maintaining an upright posture with a slight backward lean."
    ],
    "steps": [
      "Depress your scapulae and pull the handle smoothly down toward your upper chest by driving your elbows down and back.",
      "Squeeze your lats firmly at the bottom as the handle approaches collarbone level.",
      "Control the weight as you slowly reverse the motion, extending your arms fully until you feel a gentle stretch in your back before beginning the next repetition."
    ],
    "breathing": "Inhale as you allow the weight to return to the top; exhale forcefully as you pull the handles down toward your chest.",
    "cues": [
      "Lead with the elbows.",
      "Chest up to meet the bar.",
      "Control the stretch at the top."
    ],
    "common_faults": [
      {
        "fault": "Excessive leaning back to swing the weight down using momentum.",
        "correction": "Keep your torso relatively still with only a slight natural arch, pulling strictly with your back and arms."
      },
      {
        "fault": "Incomplete range of motion without full overhead extension.",
        "correction": "Allow your shoulder blades to elevate naturally at the top of each rep to achieve a full stretch."
      }
    ],
    "safety": {
      "precautions": [
        "Ensure the thigh support is locked securely to avoid being pulled upward by the weight stack."
      ],
      "spotter": "not-needed"
    }
  },
