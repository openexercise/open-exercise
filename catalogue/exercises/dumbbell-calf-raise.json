  "instructions": {
    "setup": [
      "Hold a dumbbell in each hand with arms extended naturally at your sides in a neutral grip.",
      "Stand tall with feet hip-width apart and toes pointing straight ahead, either flat on the floor or with the balls of your feet on a raised edge or plate to allow a deeper stretch.",
      "Keep knees extended but not hyperextended, brace your core, and stand balanced."
    ],
    "steps": [
      "Drive through the balls of your feet and big toes to raise your heels as high as possible.",
      "Hold the peak contraction briefly at the top while squeezing your calves.",
      "Lower your heels under control back down until you feel a full stretch at the bottom.",
      "Pause momentarily at the bottom before beginning the next repetition."
    ],
    "breathing": "Exhale as you press up onto your toes; inhale as you lower your heels back to the start.",
    "cues": [
      "Push through the big toes",
      "Squeeze hard at the peak",
      "Control the descent",
      "Knees remain straight"
    ],
    "common_faults": [
      {
        "fault": "Bouncing out of the bottom position using the Achilles tendon reflex.",
        "correction": "Pause momentarily in the stretched position to eliminate elastic recoil and maximize muscular tension."
      },
      {
        "fault": "Bending the knees to assist the lift.",
        "correction": "Maintain straight, stable knees throughout the set to emphasize the gastrocnemius."
      },
      {
        "fault": "Rolling weight outward onto the pinky toes.",
        "correction": "Focus pressure directly through the ball of the foot and big toe to maintain ankle alignment."
      }
    ],
    "safety": {
      "precautions": [
        "Ensure stable footing, especially if using a raised ledge or plate, to avoid slipping."
      ],
      "spotter": "not-needed"
    }
  },
