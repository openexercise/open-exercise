  "id": "oec:incline-dumbbell-row",
  "instructions": {
    "setup": [
      "Set an adjustable bench to an incline of roughly 30 to 45 degrees.",
      "Straddle the bench and lie face down with your chest firmly supported against the pad.",
      "Grasp a dumbbell in each hand using a neutral grip, letting your arms hang straight down with your shoulders fully relaxed and protracted."
    ],
    "steps": [
      "Initiate the pull by retracting your shoulder blades and driving your elbows up and back toward your hips.",
      "Pull the dumbbells until your upper arms are in line with your torso, pausing briefly at peak contraction.",
      "Lower the dumbbells under control back to the starting position, allowing your shoulder blades to protract at the bottom for a full stretch."
    ],
    "breathing": "Exhale as you row the weights upward; inhale smoothly as you lower them.",
    "cues": [
      "Drive with the elbows, not your hands.",
      "Keep your chest glued to the pad.",
      "Squeeze your shoulder blades together at the top."
    ],
    "common_faults": [
      {
        "fault": "Lifting the chest off the bench to generate momentum.",
        "correction": "Keep your sternum pressed firmly into the pad throughout the entire repetition."
      },
      {
        "fault": "Shrugging the shoulders toward the ears during the row.",
        "correction": "Depress your shoulders and pull your elbows back toward your pockets instead of straight up."
      }
    ],
    "safety": {
      "precautions": [
        "Select weights you can control without arching your neck or extending your spine excessively off the bench."
      ],
      "spotter": "not-needed"
    }
  },
