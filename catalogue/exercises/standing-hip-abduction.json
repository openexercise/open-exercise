  "id": "oec:standing-hip-abduction",
  "instructions": {
    "setup": [
      "Stand tall with feet hip-width apart and your core braced.",
      "Place your hands on your hips, or lightly touch a wall or chair for balance if needed.",
      "Shift your weight onto the supporting leg while maintaining a soft, unlocked knee."
    ],
    "steps": [
      "Lift the non-weight-bearing leg straight out to the side away from your midline, keeping your toes pointed forward.",
      "Pause for a brief moment at peak hip abduction without allowing your torso to tilt.",
      "Lower the leg smoothly back toward the starting position under control.",
      "Complete the prescribed repetitions, then switch and perform the movement on the opposite side."
    ],
    "breathing": "Exhale as you raise the leg out to the side; inhale as you return it to the start.",
    "cues": [
      "Lead with your heel",
      "Keep your pelvis level",
      "Stand tall without leaning"
    ],
    "common_faults": [
      {
        "fault": "Leaning the torso sideways to compensate for limited hip mobility.",
        "correction": "Keep your spine upright and only lift the leg as high as hip active range allows."
      },
      {
        "fault": "Externally rotating the foot so the toes point upward, shifting tension onto the hip flexors.",
        "correction": "Keep your foot neutral or slightly internally rotated so the toes point straight ahead or slightly inward."
      }
    ],
    "safety": {
      "precautions": [
        "Hold onto a sturdy surface like a wall or chair if balance is compromised."
      ],
      "spotter": "not-needed"
    }
  },
