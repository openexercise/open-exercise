  "instructions": {
    "setup": [
      "Adjust the saddle height so there is a slight bend in the knee (roughly 25 to 35 degrees) when the pedal is at the lowest point of the stroke.",
      "Adjust the handlebar height and reach to allow a comfortable forward hinge from the hips without rounding your spine excessively.",
      "Step onto the bike, sit firmly on the saddle, and secure your feet into the pedals or toe cages."
    ],
    "steps": [
      "Begin pedaling smoothly in a continuous circular motion, pushing down through the ball of the foot and drawing through the bottom of the stroke.",
      "Maintain a steady rhythm, keeping your knees tracking inline with your toes.",
      "Keep a relaxed grip on the handlebars and avoid collapsing your weight onto your wrists.",
      "Adjust the resistance and cadence to achieve the desired training intensity."
    ],
    "breathing": "Breathe continuously and rhythmically, matching your breathing pace to your cadence and effort level.",
    "cues": [
      "Pedal in smooth circles",
      "Knees track straight forward",
      "Relax your shoulders and grip"
    ],
    "common_faults": [
      {
        "fault": "Saddle set too low or too high.",
        "correction": "Adjust the seat height to ensure a slight bend in the knee at the bottom of the pedal stroke to avoid joint strain."
      },
      {
        "fault": "Bouncing in the saddle at high cadence.",
        "correction": "Increase the magnetic or flywheel resistance slightly to stabilize the pedal stroke."
      },
      {
        "fault": "Excessive weight bearing on handlebars with hunched shoulders.",
        "correction": "Support your upper body through your core and hips while keeping a light, relaxed grip."
      }
    ],
    "safety": {
      "precautions": [
        "Ensure all seat and handlebar adjustment pins are securely locked into place before starting."
      ],
      "spotter": "not-needed"
    }
