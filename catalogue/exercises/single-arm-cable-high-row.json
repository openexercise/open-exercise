  "instructions": {
    "setup": [
      "Set the cable pulley above head height and attach a single D-handle.",
      "Grasp the handle with one hand and take a half-kneeling or seated position facing the pulley.",
      "Extend your working arm fully forward and upward along the line of the cable, bracing your core and squaring your shoulders."
    ],
    "steps": [
      "Initiate the pull by depressing your shoulder blade and driving your elbow down and back toward your hip.",
      "Continue rowing until your hand reaches your lower ribs, squeezing your lat and upper back at the peak contraction.",
      "Pause briefly, resisting rotation through your torso.",
      "Slowly extend your arm along the line of the cable under control until your lat is fully stretched.",
      "Complete the desired repetitions, then repeat on the opposite side."
    ],
    "breathing": "Exhale as you pull the handle toward your torso, and inhale as you return the cable to the starting position.",
    "cues": [
      "Drive the elbow to your hip pocket.",
      "Keep your chest proud and square to the cable.",
      "Pull with your back, not your biceps."
    ],
    "common_faults": [
      {
        "fault": "Excessive torso rotation and momentum during the pull.",
        "correction": "Brace your core firmly and keep your chest squared to isolate the working side."
      },
      {
        "fault": "Shrugging the shoulder toward the ear at peak contraction.",
        "correction": "Keep the shoulder blade depressed down away from your neck throughout the entire range of motion."
      }
    ],
    "safety": {
      "precautions": [
        "Maintain a stable base of support to prevent being pulled forward by the cable stack."
      ],
      "spotter": "not-needed"
    }
  },
