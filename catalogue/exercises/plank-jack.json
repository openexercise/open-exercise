  "instructions": {
    "setup": [
      "Begin in a solid high plank position with your hands planted directly beneath your shoulders, arms extended, and fingers spread.",
      "Engage your core, squeeze your glutes, and start with your feet together so your body forms a straight line from head to heels."
    ],
    "steps": [
      "Brace your core firmly and hop both feet outward slightly wider than shoulder-width, landing softly on the balls of your feet.",
      "Immediately hop both feet back together to the starting position without letting your hips sag or bounce upward.",
      "Repeat the hopping motion at a controlled, rhythmic pace while keeping your torso completely stable."
    ],
    "breathing": "Maintain steady, rhythmic breathing throughout the movement, exhaling as your feet jump outward and inhaling as they return.",
    "cues": [
      "Lock your torso in place",
      "Light on your toes",
      "Don't let the hips bounce"
    ],
    "common_faults": [
      {
        "fault": "Hips sagging toward the floor during the hops.",
        "correction": "Brace the abdominals and squeeze the glutes to keep the pelvis aligned with the spine."
      },
      {
        "fault": "Hips piking high into the air with each jump.",
        "correction": "Focus on horizontal foot movement rather than jumping high; keep your shoulders and hips on the same level."
      }
    ],
    "safety": {
      "precautions": [
        "Perform on a non-slip surface to prevent your hands or feet from sliding during the movement.",
        "Transition to tapping one foot out at a time if hopping causes lower back discomfort."
      ],
      "spotter": "not-needed"
    }
  },
