  "instructions": {
    "setup": [
      "Assume a high plank position on the floor with your body forming a straight line from head to heels.",
      "Place your hands directly beneath your shoulders or slightly closer, thumbs a few inches apart.",
      "Brace your core, squeeze your glutes, and tuck your toes securely into the ground."
    ],
    "steps": [
      "Lower your body under control by bending your elbows, keeping them tracking close along the sides of your ribcage.",
      "Descend until your chest is just above the floor or lightly touches your hands.",
      "Press through your palms and extend your elbows forcefully to return to the starting plank position.",
      "Lock out your arms at the top without allowing your hips to sag."
    ],
    "breathing": "Inhale as you lower your body toward the floor, and exhale as you press back up to the lockout.",
    "cues": [
      "Elbows brushing the ribs",
      "Rigid plank throughout",
      "Push the floor away"
    ],
    "common_faults": [
      {
        "fault": "Flaring elbows excessively wide",
        "correction": "Keep elbows tucked tightly to the torso to maintain mechanical focus on the triceps and protect the shoulders."
      },
      {
        "fault": "Sagging lumbar spine or elevated hips",
        "correction": "Actively brace your abdominals and squeeze your glutes to maintain a neutral spine from heels to head."
      },
      {
        "fault": "Cutting the depth short",
        "correction": "Lower until your chest touches or comes within an inch of your hands for full range of motion."
      }
    ],
    "safety": {
      "precautions": [
        "Do not over-turn the wrists inwards if it causes discomfort; keep fingers pointing mostly forward or slightly out."
      ],
      "spotter": "not-needed"
    }
  },
