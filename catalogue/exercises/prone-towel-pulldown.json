  "instructions": {
    "setup": [
      "Lie face down on the floor or an exercise mat with your legs extended straight behind you.",
      "Grasp a towel or strap with an overhand grip wider than shoulder-width, holding your arms extended overhead.",
      "Engage your glutes and lower back to elevate your chest slightly off the floor, keeping your neck neutral."
    ],
    "steps": [
      "Pull outward on the towel with both hands to create continuous lateral tension.",
      "Drive your elbows down and back toward your ribs, pulling the towel in toward your upper chest.",
      "Squeeze your shoulder blades down and together at the bottom of the movement.",
      "Slowly extend your arms back overhead under control while maintaining outward tension on the towel."
    ],
    "breathing": "Inhale as you extend your arms overhead, and exhale forcefully as you pull the towel down toward your chest.",
    "cues": [
      "Rip the towel apart",
      "Drive elbows to hips",
      "Keep chest proud, gaze down"
    ],
    "common_faults": [
      {
        "fault": "Losing tension on the towel",
        "correction": "Actively pull outward with your hands throughout the entire rep to keep the lats and upper back engaged."
      },
      {
        "fault": "Hyperextending the cervical spine",
        "correction": "Keep your gaze directed toward the floor rather than looking up to protect the neck."
      },
      {
        "fault": "Shrugging the shoulders toward the ears",
        "correction": "Depress your scapulae and think about pulling your elbows down into your back pockets."
      }
    ],
    "safety": {
      "precautions": [
        "Do not excessively arch the lower back if prone extension causes lumbar discomfort."
      ],
      "spotter": "not-needed"
    }
  },
