  "instructions": {
    "setup": [
      "Lie on your side on a mat or flat bench with your working arm on top.",
      "Support your head with your bottom arm or a small pillow to keep the neck neutral.",
      "Bend the elbow of your working arm to 90 degrees and pin the upper arm against your flank.",
      "Grasp a light dumbbell with a neutral grip so your forearm rests across your abdomen."
    ],
    "steps": [
      "Keeping your elbow pinned firmly to your side at 90 degrees, rotate your forearm upward toward the ceiling.",
      "Pause briefly at the top of the movement without letting your torso roll backward.",
      "Slowly lower the dumbbell back across your abdomen under complete control.",
      "Complete all repetitions on one side before switching to the other."
    ],
    "breathing": "Exhale as you rotate the weight upward; inhale as you lower it back to your stomach.",
    "cues": [
      "Keep the elbow pinned to your side.",
      "Rotate from the shoulder, not the wrist.",
      "Do not roll your chest open toward the ceiling."
    ],
    "common_faults": [
      {
        "fault": "Allowing the elbow to drift away from the torso during rotation.",
        "correction": "Place a rolled towel between your elbow and ribcage and keep it pressed in place throughout the set."
      },
      {
        "fault": "Rolling the torso backward to cheat the weight up.",
        "correction": "Keep your hips and shoulders stacked vertically and only move through the shoulder joint."
      },
      {
        "fault": "Extending or flexing the wrist to simulate more range of motion.",
        "correction": "Keep the wrist rigid in a neutral alignment throughout the repetition."
      }
    ],
    "safety": {
      "precautions": [
        "Use very light resistance; the rotator cuff muscles are small and easily strained."
      ],
      "spotter": "not-needed"
    }
  },
