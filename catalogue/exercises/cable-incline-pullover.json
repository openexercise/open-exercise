  "id": "oec:cable-incline-pullover",
  "instructions": {
    "setup": [
      "Set an adjustable bench to an incline of 30 to 45 degrees, facing toward a high cable pulley.",
      "Attach a rope attachment to the cable pulley.",
      "Straddle the bench and lean your chest firmly against the incline pad, taking hold of the rope handles with a neutral grip.",
      "Allow your arms to extend overhead toward the pulley so tension is placed on the lats."
    ],
    "steps": [
      "Set your shoulder blades down and pull through your elbows, driving your hands downward and back in a sweeping arc toward your hips.",
      "Keep a slight, fixed bend in your elbows throughout the pull without curling or rowing the weight.",
      "Squeeze your lats forcefully as your hands reach the sides of your thighs.",
      "Slowly reverse the motion under control, returning the rope overhead until you feel a full stretch through your back."
    ],
    "breathing": "Exhale as you sweep the rope downward toward your hips, and inhale as you return the cable overhead into the stretched position.",
    "cues": [
      "Chest pinned to the pad",
      "Sweep to your pockets",
      "Drive with the elbows"
    ],
    "common_faults": [
      {
        "fault": "Excessively bending and extending the elbows, turning the exercise into a triceps pressdown or row.",
        "correction": "Lock a soft bend in the elbows from the start and maintain that exact angle throughout the entire rep."
      },
      {
        "fault": "Shrugging the shoulders upward during the pull.",
        "correction": "Depress the shoulder blades before beginning the stroke and keep the shoulders pulled down away from the ears."
      }
    ],
    "safety": {
      "precautions": [
        "Ensure the bench is securely anchored and cannot slide toward the cable stack under load."
      ],
      "spotter": "not-needed"
    }
  },
