  "id": "oec:resistance-band-seated-row",
  "instructions": {
    "setup": [
      "Sit upright on the floor or an exercise mat with your legs extended in front of you and a slight, soft bend in your knees.",
      "Loop the center of a resistance band securely around the midfoot or arches of both feet.",
      "Grasp each end of the band with arms fully extended, taking up tension so there is no slack."
    ],
    "steps": [
      "Sit tall with your chest lifted and brace your core.",
      "Pull the band handles toward your lower ribs by driving your elbows straight back.",
      "Squeeze your shoulder blades together at full contraction while keeping your torso stationary.",
      "Slowly extend your arms back to the starting position under control, resisting the band's pull."
    ],
    "breathing": "Exhale as you pull the band toward your torso and inhale as you return to the starting position.",
    "cues": [
      "Lead with the elbows.",
      "Proud chest throughout.",
      "Squeeze the shoulder blades back."
    ],
    "common_faults": [
      {
        "fault": "Leaning back excessively to gain momentum.",
        "correction": "Keep your torso braced and upright throughout the movement without rocking backward."
      },
      {
        "fault": "Shrugging the shoulders up toward the ears.",
        "correction": "Depress the shoulder blades and focus on pulling low toward the hips or ribcage."
      },
      {
        "fault": "Band slipping off the feet.",
        "correction": "Anchor the band securely across the arches of the feet and maintain active ankle dorsiflexion."
      }
    ],
    "safety": {
      "precautions": [
        "Ensure the resistance band is free of tears and securely positioned across the midfoot before pulling."
      ],
      "spotter": "not-needed"
    }
  },
