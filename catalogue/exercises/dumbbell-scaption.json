  "instructions": {
    "setup": [
      "Stand tall with feet shoulder-width apart and your core braced.",
      "Hold a dumbbell in each hand at your sides with a neutral grip (thumbs pointing up or forward) and elbows slightly unlocked."
    ],
    "steps": [
      "Raise both dumbbells upward in the scapular plane, approximately 30 to 45 degrees forward of straight out to the sides.",
      "Continue lifting until your hands reach shoulder height.",
      "Pause briefly at the peak of the movement, maintaining control through the shoulder girdle.",
      "Lower the dumbbells smoothly along the same diagonal path back to the starting position."
    ],
    "breathing": "Exhale as you raise the dumbbells; inhale smoothly as you lower them.",
    "cues": [
      "Thumbs angled toward the ceiling.",
      "Lift in a shallow V-shape.",
      "Keep shoulders down away from your ears."
    ],
    "common_faults": [
      {
        "fault": "Lifting strictly straight in front or directly out to the side.",
        "correction": "Move along the natural scapular plane, roughly 30 to 45 degrees forward of the frontal plane."
      },
      {
        "fault": "Swinging the torso or using momentum to lift the weights.",
        "correction": "Select lighter dumbbells and maintain a strict, stable upright posture."
      },
      {
        "fault": "Excessive shrugging of the upper traps at the top of the lift.",
        "correction": "Keep your shoulder blades depressed and focus on upward rotation rather than pure shrugging."
      }
    ],
    "safety": {
      "precautions": [
        "Avoid using excessively heavy weights that cause form breakdown or impingement symptoms."
      ],
      "spotter": "not-needed"
    }
  },
