  "id": "oec:explosive-push-up",
  "instructions": {
    "setup": [
      "Assume a high plank position with your hands placed slightly wider than shoulder-width apart.",
      "Position your feet hip-width apart and squeeze your glutes and core to create a rigid, straight line from head to heels."
    ],
    "steps": [
      "Lower your chest under control toward the floor by flexing your elbows at roughly a 45-degree angle to your body.",
      "Just before your chest touches the floor, reverse direction and press into the ground with maximal speed.",
      "Accelerate forcefully until your hands leave the floor at the peak of the movement.",
      "Land softly by catching the ground with your hands and immediately bending your elbows to absorb impact into the next descent."
    ],
    "breathing": "Inhale smoothly as you lower your body, then exhale forcefully as you explode off the floor.",
    "cues": [
      "Push the floor away explosively",
      "Stay rigid in the air",
      "Cushion the landing softly"
    ],
    "common_faults": [
      {
        "fault": "Landing with stiff, locked elbows, placing high shock on the joints.",
        "correction": "Catch the floor with soft elbows and immediately yield into the descent to absorb force."
      },
      {
        "fault": "Sagging the hips and extending the lumbar spine during the explosive drive or landing.",
        "correction": "Brace your core and glutes firmly to maintain a neutral spine throughout the repetition."
      },
      {
        "fault": "Flaring the elbows out perpendicular to the torso.",
        "correction": "Keep your elbows angled at roughly 45 degrees relative to your torso to protect the shoulders."
      }
    ],
    "safety": {
      "precautions": [
        "Ensure wrist and shoulder mobility are adequate before performing high-impact plyometric upper body work."
      ],
      "spotter": "not-needed"
    }
  },
