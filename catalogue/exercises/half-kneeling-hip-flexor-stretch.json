  "id": "oec:half-kneeling-hip-flexor-stretch",
  "instructions": {
    "setup": [
      "Assume a half-kneeling position on the floor, placing a mat under your back knee for comfort.",
      "Position your front foot flat on the floor with both knees bent at roughly 90 degrees.",
      "Keep your torso upright with your hands placed on your front thigh or hips."
    ],
    "steps": [
      "Engage your abdominals and actively squeeze the glute of the trailing leg to tilt your pelvis posteriorly.",
      "Shift your weight slightly forward from the hips until you feel a gentle stretch across the front of the trailing hip and upper thigh.",
      "Hold the position for the desired duration while maintaining an upright posture.",
      "Release the stretch slowly and repeat on the opposite side."
    ],
    "breathing": "Breathe smoothly and deeply, using slow exhalations to help the hip flexors relax into the stretch.",
    "cues": [
      "Squeeze the back glute",
      "Tuck your tailbone",
      "Stay tall through the torso"
    ],
    "common_faults": [
      {
        "fault": "Excessively arching the lower back to simulate hip extension",
        "correction": "Brace your core and perform a posterior pelvic tilt before shifting forward."
      },
      {
        "fault": "Lurching too far forward without engaging the trailing glute",
        "correction": "Keep the forward shift small and controlled, emphasizing pelvic position over forward travel."
      }
    ],
    "safety": {
      "precautions": [
        "Use a padded mat under the back knee if you experience patellar discomfort."
      ],
      "spotter": "not-needed"
    }
  },
