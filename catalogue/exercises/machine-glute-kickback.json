  "instructions": {
    "setup": [
      "Adjust the machine's chest, abdominal, or arm pads to align your hip joint with the machine's axis of rotation.",
      "Grasp the machine handles firmly and brace your core.",
      "Place the sole of your working foot or the back of your lower thigh securely against the movement pad, with the non-working foot firmly planted on the platform."
    ],
    "steps": [
      "Brace your abdominals and drive through your heel to push the lever arm straight back into full hip extension.",
      "Pause briefly at peak contraction, focusing on squeezing the working glute.",
      "Lower the weight back to the starting position in a controlled motion without letting the weight stack touch down between reps."
    ],
    "breathing": "Exhale as you press the pad backward into extension; inhale as you slowly return to the starting position.",
    "cues": [
      "Drive through the heel",
      "Lock your torso in place",
      "Squeeze the glute at the top"
    ],
    "common_faults": [
      {
        "fault": "Hyperextending the lumbar spine at peak extension to gain extra range of motion.",
        "correction": "Brace the abdominals firmly and only extend as far as the hip joint allows without arching the lower back."
      },
      {
        "fault": "Swinging the leg and relying on momentum rather than controlled muscular effort.",
        "correction": "Pause briefly at peak contraction and lower the pad slowly under control rather than letting it swing back."
      }
    ],
    "safety": {
      "precautions": [
        "Maintain a neutral spine throughout the movement to protect the lower back."
      ],
      "spotter": "not-needed"
    }
  },
