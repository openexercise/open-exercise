  "instructions": {
    "setup": [
      "Set the cable pulley to its lowest position and attach a single D-handle.",
      "Stand sideways to the cable stack with your feet hip-width apart.",
      "Reach across your body with the outside arm to grip the handle with a neutral-to-pronated grip.",
      "Stand tall with a slight bend in your working elbow and brace your core."
    ],
    "steps": [
      "Raise your arm out to the side in the scapular plane, leading with your elbow.",
      "Continue raising until your hand and elbow reach roughly shoulder height.",
      "Pause briefly at the top to emphasize peak contraction in the lateral deltoid.",
      "Lower the handle under control back across your body to the starting position."
    ],
    "breathing": "Exhale as you raise the cable to the side, and inhale as you lower it back down.",
    "cues": [
      "Lead with the elbow.",
      "Pour the pitcher slightly at the top.",
      "Keep your shoulders down and avoid shrugging."
    ],
    "common_faults": [
      {
        "fault": "Excessive shrugging of the shoulder girdle.",
        "correction": "Keep your shoulder blades depressed and focus on abducting at the shoulder joint rather than elevating the traps."
      },
      {
        "fault": "Swinging the torso to generate momentum.",
        "correction": "Reduce the load, brace your core, and keep your torso stationary throughout the movement."
      },
      {
        "fault": "Raising the hand well above the elbow.",
        "correction": "Keep the elbow and wrist in line or the elbow slightly higher to ensure the tension remains on the lateral deltoid."
      }
    ],
    "safety": {
      "precautions": [
        "Avoid raising the arm excessively beyond shoulder height if you experience impingement or shoulder discomfort."
      ],
      "spotter": "not-needed"
    }
  },
