  "id": "oec:neck-roll",
  "instructions": {
    "setup": [
      "Sit tall in a chair or cross-legged on the floor with your shoulders relaxed and down away from your ears.",
      "Gently drop your chin toward your chest without forcing the stretch."
    ],
    "steps": [
      "Slowly roll your right ear toward your right shoulder.",
      "Continue the smooth circle by gently tipping your head back to look toward the ceiling, avoiding aggressive backward compression.",
      "Trace the circle over to the left side, bringing your left ear toward your left shoulder.",
      "Complete the revolution by returning your chin to the starting position at your chest.",
      "Repeat for the desired repetitions, then reverse direction."
    ],
    "breathing": "Breathe smoothly and continuously, exhaling as the chin rolls forward and inhaling as the head tilts backward.",
    "cues": [
      "Slow and controlled",
      "Keep shoulders down",
      "Draw a smooth circle with the crown of your head"
    ],
    "common_faults": [
      {
        "fault": "Shrugging the shoulders up toward the ears",
        "correction": "Actively depress and relax the shoulder blades throughout the movement."
      },
      {
        "fault": "Moving too quickly or using momentum",
        "correction": "Slow the motion down to maintain full muscular control and avoid joint irritation."
      },
      {
        "fault": "Forcing aggressive hyperextension of the neck",
        "correction": "Keep the backward roll gentle and elongated rather than hinging sharply backward."
      }
    ],
    "safety": {
      "precautions": [
        "Stop immediately if you experience sharp pain, dizziness, or tingling down your arms."
      ],
      "spotter": "not-needed"
    }
  },
