  "instructions": {
    "setup": [
      "Stand between parallel dip bars and grasp each bar firmly with a neutral grip.",
      "Jump or press yourself up so your arms are fully extended and your body hangs freely above the floor.",
      "Engage your core, bring your legs together, and depress your shoulders away from your ears."
    ],
    "steps": [
      "Maintain active scapular depression by driving your palms down into the bars.",
      "Keep your elbows locked straight without hyperextending.",
      "Hold this rigid, tall position for the prescribed duration.",
      "Lower your feet back to the floor with control when finished."
    ],
    "breathing": "Breathe smoothly and continuously into your diaphragm while maintaining isometric core and shoulder tension.",
    "cues": [
      "Push the floor away",
      "Long neck",
      "Lock the elbows",
      "Brace the abs"
    ],
    "common_faults": [
      {
        "fault": "Allowing the shoulders to shrug up toward the ears.",
        "correction": "Actively press down through your hands to keep your chest proud and your shoulders fully depressed."
      },
      {
        "fault": "Soft or bent elbows during the hold.",
        "correction": "Flex your triceps to ensure your elbows remain fully extended throughout the set."
      },
      {
        "fault": "Arching the lower back and letting the legs swing loosely.",
        "correction": "Squeeze your glutes and brace your abs to maintain a solid hollow-body or neutral posture."
      }
    ],
    "safety": {
      "precautions": [
        "Ensure the dip bars are stable and securely set before bearing weight.",
        "Exit the hold immediately if you experience sharp pain in the anterior shoulder or sternum."
      ],
      "spotter": "not-needed"
    }
  },
