  "instructions": {
    "setup": [
      "Straddle the T-bar apparatus or landmine barbell with feet shoulder-width apart.",
      "Hinge at your hips with knees slightly bent until your torso is angled around 45 degrees relative to the floor.",
      "Grasp the handles firmly with arms fully extended and your spine braced in neutral alignment."
    ],
    "steps": [
      "Pull the weight upward toward your upper abdomen or lower chest by driving your elbows back and retracting your shoulder blades.",
      "Squeeze your back musculature hard at the peak of the contraction without changing your torso angle.",
      "Lower the weight smoothly under control until your arms are fully extended and your lats stretch.",
      "Repeat for the desired number of repetitions."
    ],
    "breathing": "Inhale and brace before initiating the pull, and exhale as you complete the concentric phase or slowly during the descent.",
    "cues": [
      "Drive your elbows toward your hips.",
      "Keep your chest proud and spine flat.",
      "Pull with your back, not your biceps."
    ],
    "common_faults": [
      {
        "fault": "Using excessive hip thrust and torso swing to heave the weight up.",
        "correction": "Reduce the load and keep your hip hinge and torso angle strictly stationary throughout the set."
      },
      {
        "fault": "Rounding the lumbar spine under load.",
        "correction": "Brace your abdominals and maintain a neutral spine with active hamstring tension."
      },
      {
        "fault": "Cutting the range of motion short at the bottom or top.",
        "correction": "Allow full arm extension at the bottom for a deep stretch and pull until the handles reach the torso."
      }
    ],
    "safety": {
      "precautions": [
        "Ensure the pivot point of the bar is securely anchored before lifting.",
        "Maintain a neutral spine under load to protect the lower back."
      ],
      "spotter": "not-needed"
    }
  },
