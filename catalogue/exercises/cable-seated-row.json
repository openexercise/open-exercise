  "instructions": {
    "setup": [
      "Sit on the bench facing the low pulley and place your feet securely on the footrests with knees slightly bent.",
      "Hinge slightly forward at the hips to grasp the handle, then sit upright with an erect spine, braced core, and arms fully extended."
    ],
    "steps": [
      "Initiate the pull by retracting your shoulder blades and driving your elbows straight back alongside your ribcage.",
      "Pull the handle firmly toward your lower abdomen while keeping your torso upright and stationary.",
      "Pause briefly at peak contraction, squeezing your shoulder blades together.",
      "Control the weight back under tension until your arms are fully extended and shoulders protracted forward slightly."
    ],
    "breathing": "Exhale as you pull the handle into your abdomen, and inhale as you return the weight stack.",
    "cues": [
      "Lead with the elbows, not the hands.",
      "Chest proud and shoulders down.",
      "Keep the torso stable; do not swing."
    ],
    "common_faults": [
      {
        "fault": "Swinging the torso backward and forward to generate momentum.",
        "correction": "Keep your hips locked and maintain a stationary, upright spine throughout the movement."
      },
      {
        "fault": "Shrugging the shoulders up toward the ears during the pull.",
        "correction": "Depress your scapulae and keep your traps relaxed before driving the elbows back."
      },
      {
        "fault": "Rounding the lower back when reaching forward.",
        "correction": "Maintain a neutral spine and stop reaching forward once your arms are fully extended."
      }
    ],
    "safety": {
      "precautions": [
        "Avoid hyperextending the lumbar spine under heavy loads."
      ],
      "spotter": "not-needed"
    }
  },
