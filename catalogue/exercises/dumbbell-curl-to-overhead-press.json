  "instructions": {
    "setup": [
      "Stand tall with feet hip-width apart holding a dumbbell in each hand at your sides.",
      "Brace your core and allow your arms to hang naturally with palms facing your torso."
    ],
    "steps": [
      "Curl the dumbbells upward toward shoulder height, supinating your forearms so your palms face inward or backward at the top of the curl.",
      "Smoothly transition into the press by rotating your hands outward and pressing the dumbbells overhead until your arms are fully extended.",
      "Lower the dumbbells back to shoulder height under control.",
      "Reverse the curl by lowering the dumbbells down to your sides in a controlled eccentric tempo."
    ],
    "breathing": "Inhale before curling, exhale as you complete the press overhead, and inhale while lowering the weights back down.",
    "cues": [
      "Curl, transition, press",
      "Lock down your ribs",
      "Control the descent on both phases"
    ],
    "common_faults": [
      {
        "fault": "Swinging the torso to curl heavy weight.",
        "correction": "Select a load you can curl strictly without hip momentum or backward lean."
      },
      {
        "fault": "Hyperextending the lower back during the overhead press.",
        "correction": "Squeeze the glutes and brace the abs to maintain a neutral spine throughout the press."
      }
    ],
    "safety": {
      "precautions": [
        "Avoid using momentum to transition between the curl and press to protect the shoulder joint."
      ],
      "spotter": "not-needed"
    }
  },
