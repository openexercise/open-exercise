  "id": "oec:standing-straight-leg-kick",
  "instructions": {
    "setup": [
      "Stand tall with feet hip-width apart and your posture upright.",
      "Extend your arms straight out in front of your chest at shoulder height, palms facing down."
    ],
    "steps": [
      "Keeping your torso upright and core engaged, kick one leg straight out in front of you toward your opposite hand.",
      "Keep the kicking knee extended and your toes dorsiflexed toward your shin until you feel a dynamic stretch through the hamstring.",
      "Lower the leg back to the floor under control.",
      "Repeat the movement with the opposite leg."
    ],
    "breathing": "Exhale as you kick your leg upward and inhale as you lower your foot back to the ground.",
    "cues": [
      "Stay tall through the torso",
      "Kick with control, not momentum",
      "Toes up to your shin"
    ],
    "common_faults": [
      {
        "fault": "Rounding the lower back and reaching the chest forward to touch the foot.",
        "correction": "Keep the spine neutral and bring the leg to the hand, not the hand or chest to the leg."
      },
      {
        "fault": "Bending the kicking knee excessively.",
        "correction": "Maintain a soft but extended knee to ensure the stretch reaches the hamstring belly."
      }
    ],
    "safety": {
      "precautions": [
        "Increase kicking height progressively as your hamstrings warm up rather than forcing maximal range of motion immediately."
      ],
      "spotter": "not-needed"
    }
  },
