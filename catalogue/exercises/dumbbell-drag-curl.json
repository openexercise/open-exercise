  "instructions": {
    "setup": [
      "Stand tall with feet hip-width apart, holding a dumbbell in each hand with an underhand (supinated) grip.",
      "Let your arms hang straight down with the dumbbells resting against your upper thighs."
    ],
    "steps": [
      "Initiate the movement by driving your elbows backward and upward behind your torso.",
      "Flex your elbows to pull the dumbbells straight upward, keeping the weights in close contact with your abdomen and chest throughout the ascent.",
      "Squeeze your biceps hard at the peak of the movement around upper chest height.",
      "Lower the dumbbells along the same vertical path, allowing your elbows to return forward to the starting position."
    ],
    "breathing": "Exhale as you drag the dumbbells upward; inhale as you lower them with control.",
    "cues": [
      "Drag the weights up your shirt.",
      "Elbows back, not forward.",
      "Keep tension on the biceps at the top."
    ],
    "common_faults": [
      {
        "fault": "Swinging the elbows forward as in a traditional curl.",
        "correction": "Actively pull the elbows backward throughout the rep so the path of the dumbbells is purely vertical."
      },
      {
        "fault": "Using torso momentum or leaning back.",
        "correction": "Keep your core tight, ribs down, and spine neutral without arching backward."
      }
    ],
    "safety": {
      "spotter": "not-needed"
    }
