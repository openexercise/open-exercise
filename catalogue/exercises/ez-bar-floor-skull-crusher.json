  "instructions": {
    "setup": [
      "Lie flat on your back on the floor or an exercise mat, with knees bent and feet flat on the ground.",
      "Hold an EZ-bar above your upper chest or forehead with an overhand grip on the inner bends, arms extended."
    ],
    "steps": [
      "Lower the bar under control by bending at the elbows until the weight plates gently touch the floor overhead behind your head.",
      "Allow the weight to come to a brief, dead-stop pause on the floor without letting tension leave the triceps completely.",
      "Drive the weight back up by extending your elbows until your arms return to the starting position."
    ],
    "breathing": "Inhale as you lower the bar to the floor, and exhale as you press back up to full extension.",
    "cues": [
      "Keep upper arms stationary",
      "Dead stop on the floor, no bouncing",
      "Drive through the triceps"
    ],
    "common_faults": [
      {
        "fault": "Bouncing the plates off the floor to gain momentum.",
        "correction": "Pause completely on the floor to eliminate the stretch reflex before extending."
      },
      {
        "fault": "Flaring the elbows outward excessively during the press.",
        "correction": "Keep the elbows tucked shoulder-width apart and pointing toward the ceiling throughout the repetition."
      }
    ],
    "safety": {
      "precautions": [
        "Ensure standard-sized plates or bumpers are used if needed so the bar settles at an appropriate height overhead without risking facial contact."
      ],
      "spotter": "not-needed"
    }
  },
