  "id": "oec:high-plank",
  "instructions": {
    "setup": [
      "Start on all fours with your hands placed directly underneath your shoulders, fingers spread comfortably.",
      "Step your feet back one at a time to extend your legs, supporting your weight on your hands and the balls of your feet with feet hip-width apart.",
      "Press the floor away through your palms to spread your shoulder blades and create a straight line from your head to your heels."
    ],
    "steps": [
      "Lock your position by bracing your abdominals, squeezing your glutes, and engaging your quadriceps.",
      "Hold this rigid straight-arm position for the target duration without allowing your hips to sag or hike upward.",
      "Lower your knees gently to the floor when the set is complete."
    ],
    "breathing": "Breathe continuously and evenly through your nose and mouth without releasing abdominal tension.",
    "cues": [
      "Push the ground away.",
      "Ribs toward your pelvis.",
      "Squeeze glutes and thighs tight."
    ],
    "common_faults": [
      {
        "fault": "Sagging at the hips and hyperextending the lower back.",
        "correction": "Tuck your pelvis slightly under and aggressively brace your core and glutes to restore a neutral spine."
      },
      {
        "fault": "Piking the hips up into a tent shape to relieve core tension.",
        "correction": "Lower your hips until your shoulders, hips, and ankles align in a straight plane."
      },
      {
        "fault": "Winged scapulae with sunken chest.",
        "correction": "Actively push through your hands to keep your upper back slightly rounded and shoulder blades protracted."
      }
    ],
    "safety": {
      "precautions": [
        "Those with wrist discomfort can elevate hands on parallettes or perform the movement on their forearms."
      ],
      "spotter": "not-needed"
    }
  },
