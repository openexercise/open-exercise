  "id": "oec:machine-underhand-close-grip-row",
  "instructions": {
    "setup": [
      "Adjust the seat height so that your chest rests comfortably against the upper chest pad.",
      "Sit facing the machine and plant your feet firmly on the footplates or floor.",
      "Reach forward and take a close, underhand grip on the handles with palms facing upward."
    ],
    "steps": [
      "Keep your chest braced firmly against the pad and pull your shoulders down and back.",
      "Drive your elbows backward tight along your ribcage, pulling the handles toward your lower abdomen.",
      "Squeeze your lats and mid-back at the end of the range of motion for a brief pause.",
      "Lower the weight smoothly by extending your arms forward until your lats are fully stretched."
    ],
    "breathing": "Exhale as you pull the handles toward your torso, and inhale as you return them to the starting position.",
    "cues": [
      "Lead with your elbows.",
      "Keep elbows tight to your sides.",
      "Stay glued to the chest pad."
    ],
    "common_faults": [
      {
        "fault": "Flaring the elbows outward.",
        "correction": "Keep your elbows tucked close to your torso throughout the pull to emphasize the lats."
      },
      {
        "fault": "Excessively leaning back and pulling your chest off the pad.",
        "correction": "Maintain constant, firm contact with the chest pad to prevent using momentum."
      },
      {
        "fault": "Shrugging the shoulders upward.",
        "correction": "Depress your shoulder blades down and back before starting the row."
      }
    ],
    "safety": {
      "precautions": [
        "Do not allow the weight stack to slam down at the bottom of the movement."
      ],
      "spotter": "not-needed"
    }
