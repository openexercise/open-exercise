  "instructions": {
    "setup": [
      "Stand under a pull-up bar and grasp it with an overhand (pronated) grip, about shoulder-width apart.",
      "Step onto a box or jump up to position your chest near the bar and clear your chin fully above bar height."
    ],
    "steps": [
      "Drive your elbows down and back while retracting and depressing your shoulder blades.",
      "Brace your core and squeeze your glutes and legs together to prevent swinging.",
      "Hold the chin-over-bar position rigidly for the target duration.",
      "Lower yourself under control to a dead hang or step back down onto the box."
    ],
    "breathing": "Take short, controlled breaths while maintaining abdominal bracing throughout the hold.",
    "cues": [
      "Elbows down into your back pockets",
      "Chest up to the bar",
      "Keep the core braced and legs tight"
    ],
    "common_faults": [
      {
        "fault": "Reaching and hyperextending the neck to clear the chin over the bar.",
        "correction": "Keep the cervical spine neutral and focus on elevating the chest to clear the bar."
      },
      {
        "fault": "Allowing the shoulders to shrug up toward the ears.",
        "correction": "Actively depress the scapulae, pulling the shoulders down away from the ears."
      },
      {
        "fault": "Swinging or flailing the legs to maintain height.",
        "correction": "Squeeze the legs and glutes together in a hollow-body position to eliminate swinging."
      }
    ],
    "safety": {
      "precautions": [
        "Ensure the pull-up bar is securely anchored and has adequate clearance.",
        "Place a stable step or box underneath if you cannot safely jump up or step down."
      ],
      "spotter": "not-needed"
    }
  },
