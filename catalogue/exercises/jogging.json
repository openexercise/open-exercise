  "instructions": {
    "setup": [
      "Stand tall with feet hip-width apart, arms relaxed at your sides, and gaze forward.",
      "Engage your core lightly and maintain an upright posture with a slight lean forward from the ankles."
    ],
    "steps": [
      "Push off the ground with one foot, driving the opposite knee slightly forward in a controlled stride.",
      "Land lightly beneath your center of mass with a midfoot strike, allowing the knee and ankle to absorb the impact.",
      "Immediately transition to pushing off into the next stride, alternating legs in a fluid, rhythmic cycle.",
      "Swing your arms naturally in opposition to your legs with elbows bent at approximately ninety degrees."
    ],
    "breathing": "Breathe rhythmically and naturally through your nose and mouth at a conversational pace.",
    "cues": [
      "Stay tall with a slight forward lean",
      "Land softly under your hips",
      "Keep your shoulders relaxed"
    ],
    "common_faults": [
      {
        "fault": "Overstriding by reaching the foot far in front of the body with a heavy heel strike.",
        "correction": "Shorten your stride and aim for a higher cadence so your feet land directly beneath your hips."
      },
      {
        "fault": "Hunching the shoulders and tensing the upper body.",
        "correction": "Drop your shoulders away from your ears and keep your hands loosely cupped."
      }
    ],
    "safety": {
      "precautions": [
        "Wear well-fitted running shoes with adequate support and cushioning.",
        "Increase weekly distance and duration gradually to prevent overuse injuries."
      ],
