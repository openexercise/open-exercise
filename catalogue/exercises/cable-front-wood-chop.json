  "instructions": {
    "setup": [
      "Set the cable pulley to its highest setting and attach a rope or bar handle.",
      "Stand facing the cable machine with your feet shoulder-width apart and knees slightly bent.",
      "Grasp the attachment firmly with both hands overhead, keeping your arms extended with a slight bend in your elbows."
    ],
    "steps": [
      "Brace your core and pull the attachment down directly in front of your body toward your thighs.",
      "Hinge slightly at the hips and flex your torso forward as your hands pass your chest, focusing on abdominal contraction.",
      "Pause briefly at the bottom of the movement while actively squeezing your lats and abs.",
      "Control the weight as it rises, extending your hips and returning your arms smoothly to the overhead starting position."
    ],
    "breathing": "Exhale forcefully as you chop downward, and inhale as you return the cable overhead.",
    "cues": [
      "Pull with your lats and abs",
      "Keep your elbow angle locked",
      "Control the ascent"
    ],
    "common_faults": [
      {
        "fault": "Bending and extending the elbows excessively, turning the movement into a triceps pushdown.",
        "correction": "Maintain a fixed, soft bend in the elbows throughout and drive the movement through shoulder extension and trunk flexion."
      },
      {
        "fault": "Hyperextending the lower back at the top of the movement.",
        "correction": "Keep your core braced and ribs pulled down even when your arms are fully overhead."
      }
    ],
    "safety": {
      "precautions": [
        "Select a load that allows full control during both the downward pull and the overhead return."
      ],
      "spotter": "not-needed"
    }
  },
