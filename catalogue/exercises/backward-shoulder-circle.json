  "id": "oec:backward-shoulder-circle",
  "instructions": {
    "setup": [
      "Stand or sit upright with your spine neutral and shoulders relaxed.",
      "Place your fingertips lightly on top of your shoulders with your elbows pointing out to the sides."
    ],
    "steps": [
      "Trace large, smooth circles backward with your elbows, moving them forward, upward, backward, and downward.",
      "Squeeze your shoulder blades together and down as your elbows pass through the rear and bottom of the circle.",
      "Continue circling backward in a continuous, controlled rhythm for the desired repetitions or duration."
    ],
    "breathing": "Breathe smoothly and continuously, inhaling as the chest opens and exhaling as the elbows cycle forward.",
    "cues": [
      "Lead with the elbows",
      "Open the chest",
      "Pinch your shoulder blades on the way back"
    ],
    "common_faults": [
      {
        "fault": "Arching the lower back to compensate for limited shoulder mobility.",
        "correction": "Brace your core and keep your ribcage down throughout the movement."
      },
      {
        "fault": "Rushing through a small, jerky range of motion.",
        "correction": "Slow down and actively draw the largest smooth circle possible with your elbows."
      }
    ],
    "safety": {
      "precautions": [
        "If you feel sharp pain or pinching in the shoulder, reduce the diameter of the circle or stop."
      ],
      "spotter": "not-needed"
    }
  },
