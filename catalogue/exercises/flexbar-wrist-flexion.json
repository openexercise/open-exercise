  "id": "oec:flexbar-wrist-flexion",
  "instructions": {
    "setup": [
      "Sit on a chair or bench and rest your working forearm across your thigh or a flat table.",
      "Position your wrist and hand just past the supporting edge with your palm facing upward.",
      "Grip one end of the flexible resistance bar firmly."
    ],
    "steps": [
      "Allow your wrist to slowly extend downward toward the floor into a comfortable stretch.",
      "Curl your wrist upward toward your body as far as comfortable while keeping your forearm stationary.",
      "Squeeze at the top, then slowly lower the bar back to the starting position over two to three seconds."
    ],
    "breathing": "Exhale as you curl your wrist upward and inhale as you lower the bar down.",
    "cues": [
      "Keep the forearm pinned down",
      "Move only through the wrist",
      "Control the descent"
    ],
    "common_faults": [
      {
        "fault": "Lifting the forearm off the support",
        "correction": "Keep your entire forearm anchored to the thigh or table so the movement is isolated to the wrist."
      },
      {
        "fault": "Dropping the weight too quickly",
        "correction": "Lower the bar under control for at least two to three seconds on each repetition."
      }
    ],
    "safety": {
      "precautions": [
        "Do not force deep wrist extension if experiencing acute medial epicondylalgia or forearm pain."
      ],
      "spotter": "not-needed"
    }
  },
