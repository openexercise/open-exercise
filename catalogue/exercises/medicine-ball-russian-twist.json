  "instructions": {
    "setup": [
      "Sit on an exercise mat with knees bent and feet flat on the floor or lightly elevated for an added challenge.",
      "Hold a medicine ball with both hands close to your chest or slightly extended in front of your torso.",
      "Lean back slightly until your torso is at roughly a 45-degree angle with the floor, keeping your spine neutral and core braced."
    ],
    "steps": [
      "Rotate your torso smoothly to one side, bringing the medicine ball toward the floor beside your hip.",
      "Pause briefly under control without letting the ball slam into the ground.",
      "Rotate your torso back through the center and across to the opposite side to complete one rep."
    ],
    "breathing": "Breathe continuously, exhaling as you rotate to the side and inhaling as you cross through the center.",
    "cues": [
      "Turn your shoulders, not just your arms",
      "Keep your chest proud and spine long",
      "Control the rotation without momentum"
    ],
    "common_faults": [
      {
        "fault": "Moving only the arms from side to side without rotating the ribcage and torso.",
        "correction": "Focus on driving the movement by rotating your chest and shoulders, allowing your hands to simply follow the torso."
      },
      {
        "fault": "Excessively rounding the lumbar spine.",
        "correction": "Maintain a flat back and proud chest, hinging from the hips to sit at the 45-degree incline."
      },
      {
        "fault": "Excessive leg swaying or hip shifting.",
        "correction": "Anchor your feet to the floor or squeeze your knees together to keep the lower body stable throughout the movement."
      }
    ],
    "safety": {
      "precautions": [
        "Avoid aggressively twisting under heavy loads if you have a history of lumbar disc pathology."
      ],
      "spotter": "not-needed"
    }
  },
