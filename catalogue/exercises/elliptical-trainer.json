  "instructions": {
    "setup": [
      "Step carefully onto the foot pedals one foot at a time while holding the stationary handles for balance.",
      "Stand upright with your core braced and grasp the moving handlebars with a comfortable neutral grip.",
      "Select your program, resistance, and incline on the machine console."
    ],
    "steps": [
      "Push downward and forward with one leg while simultaneously pushing the opposite handlebar forward and pulling the same-side handlebar back.",
      "Allow the pedals to guide your feet in a smooth, continuous elliptical path.",
      "Transition seamlessly into pushing with the other leg to maintain a steady, rhythmic cadence.",
      "Keep your heels grounded on the pedals rather than driving purely through the toes."
    ],
    "breathing": "Breathe rhythmically in sync with your stride rate, matching breaths to foot cycles.",
    "cues": [
      "Stand tall, eyes forward",
      "Push through the whole foot",
      "Actively pump the handles"
    ],
    "common_faults": [
      {
        "fault": "Excessive leaning on the console or stationary handles, reducing muscular engagement.",
        "correction": "Maintain an upright posture and let your legs and core support your body weight."
      },
      {
        "fault": "Pedaling exclusively on the balls of the feet with elevated heels, placing undue strain on the calves and knees.",
        "correction": "Keep your feet flat against the pedals and drive through the midfoot and heel."
      },
      {
        "fault": "Setting the resistance too low and relying entirely on machine momentum.",
        "correction": "Increase resistance to maintain controlled, muscular pedal strokes at a steady cadence."
      }
    ],
    "safety": {
      "precautions": [
        "Wait for the pedals and levers to come to a complete stop before attempting to dismount the machine."
      ],
      "spotter": "not-needed"
    }
  },
