  "id": "oec:jump-squat",
  "instructions": {
    "setup": [
      "Stand tall with feet shoulder-width apart and toes pointed slightly outward.",
      "Engage your core and keep your chest lifted with arms relaxed at your sides or held in front of your chest."
    ],
    "steps": [
      "Hinge at the hips and bend your knees to lower smoothly into a squat until your thighs are roughly parallel to the ground.",
      "Explosively extend your hips, knees, and ankles simultaneously to launch vertically off the ground.",
      "Swing your arms upward to assist with momentum and reach maximum height.",
      "Land softly on the balls of your feet, immediately rolling back onto your heels and absorbing the impact by bending your knees into the next repetition."
    ],
    "breathing": "Inhale as you descend into the squat and exhale forcefully as you drive upward into the jump.",
    "cues": [
      "Push the floor away explosively",
      "Land soft like a cat",
      "Absorb right into the next squat"
    ],
    "common_faults": [
      {
        "fault": "Landing with stiff, locked knees, sending heavy impact force through the joints.",
        "correction": "Land softly on the balls of your feet and immediately bend your knees and hips to absorb the impact."
      },
      {
        "fault": "Knees caving inward (valgus collapse) during the takeoff or landing.",
        "correction": "Actively track your knees in line with your middle toes throughout both the jump and the landing."
      },
      {
        "fault": "Collapsing the torso forward during the squat phase.",
        "correction": "Keep your chest proud and maintain spinal rigidity with an engaged core."
      }
    ],
    "safety": {
      "precautions": [
        "Perform on a flat, non-slip, shock-absorbing surface such as a gym mat or rubber flooring rather than concrete."
      ],
      "spotter": "not-needed"
    }
  },
