  "instructions": {
    "setup": [
      "Stand tall with feet hip-width apart holding a dumbbell in each hand.",
      "Curl both dumbbells up to chest height into full contraction, elbows pinned close to your sides.",
      "Brace your core and maintain a supinated grip on both dumbbells."
    ],
    "steps": [
      "Keep one arm locked in the contracted top position.",
      "Lower the working dumbbell under control until your arm is fully extended.",
      "Curl the weight smoothly back up to the top contracted position.",
      "Hold that side at the top and immediately repeat the lowering and curling movement with the opposite arm.",
      "Continue alternating arms for the prescribed number of repetitions per side."
    ],
    "breathing": "Inhale as you lower one dumbbell, and exhale forcefully as you curl it back up to meet the holding arm.",
    "cues": [
      "Freeze the holding arm",
      "Lower with control",
      "Keep elbows pinned"
    ],
    "common_faults": [
      {
        "fault": "Allowing the non-working arm to drift downward during the set.",
        "correction": "Actively squeeze the biceps of the static arm to keep the dumbbell firmly at chest height."
      },
      {
        "fault": "Swinging the torso to lift the working dumbbell.",
        "correction": "Keep your glutes and core tight to eliminate any momentum from the hips or lower back."
      },
      {
        "fault": "Flaring the elbows outward.",
        "correction": "Keep your upper arms tucked alongside your ribs throughout both the dynamic and isometric phases."
      }
    ],
    "safety": {
      "precautions": [
        "Choose a lighter load than standard curls, as the continuous isometric tension increases fatigue rapidly."
      ],
      "spotter": "not-needed"
    }
  },
