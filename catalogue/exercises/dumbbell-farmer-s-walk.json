  "instructions": {
    "setup": [
      "Place two dumbbells parallel to each other on the floor roughly hip-width apart.",
      "Stand between the dumbbells with feet hip-width apart.",
      "Hinge at the hips and bend the knees with a flat back to grip the center of each handle firmly.",
      "Deadlift the weights to full standing extension, letting the dumbbells hang naturally at your sides with arms fully extended."
    ],
    "steps": [
      "Brace your core, draw your shoulders slightly down and back, and look straight ahead.",
      "Walk forward in a smooth, controlled gait using short, deliberate strides.",
      "Maintain a tall, upright posture without leaning forward or swaying from side to side.",
      "At the end of the designated distance or time, come to a complete stop and lower the dumbbells by hinging at the hips and bending the knees."
    ],
    "breathing": "Take steady, shallow breaths behind a braced core rather than holding your breath throughout the carry.",
    "cues": [
      "Stand tall through the crown of your head",
      "Crush the handles",
      "Shoulders in back pockets",
      "Short, controlled steps"
    ],
    "common_faults": [
      {
        "fault": "Allowing the shoulders to round forward and the upper back to slouch.",
        "correction": "Keep the chest proud and pack the scapulae slightly down and back throughout the walk."
      },
      {
        "fault": "Taking excessively long strides causing hip wobble and torso swaying.",
        "correction": "Shorten your stride to maintain a stable pelvis and keep your center of mass under control."
      },
      {
        "fault": "Rounding the lower back when picking up or setting down the dumbbells.",
        "correction": "Treat every pickup and touchdown like a proper deadlift with a braced core and neutral spine."
      }
    ],
    "safety": {
      "precautions": [
        "Ensure the walking path is completely clear of obstacles, plates, or clutter before starting.",
        "If grip fails, release the weights cleanly down to the sides rather than attempting to catch or control them awkwardly."
      ],
      "spotter": "not-needed"
    }
  },
