  "id": "oec:cable-triceps-pushdown",
  "instructions": {
    "setup": [
      "Attach a bar or rope handle to a high cable pulley.",
      "Stand facing the pulley with feet hip-width apart and a slight forward torso lean.",
      "Grasp the handle, pin your elbows close to your ribcage, and bring forearms just above parallel to the floor."
    ],
    "steps": [
      "Extend your elbows smoothly by pushing the attachment straight down toward your thighs.",
      "Squeeze your triceps firmly at full extension without locking the elbows aggressively.",
      "Control the handle as it rises back up until your elbows reach approximately ninety degrees of flexion."
    ],
    "breathing": "Exhale as you push the cable down into extension, and inhale as you return to the starting position.",
    "cues": [
      "Pin your elbows to your sides.",
      "Move only at the elbows.",
      "Control the weight on the way up."
    ],
    "common_faults": [
      {
        "fault": "Allowing the elbows to drift forward and backward during the movement.",
        "correction": "Lock the upper arms firmly against the ribcage so movement occurs strictly at the elbow joint."
      },
      {
        "fault": "Using excessive body momentum or pressing downward with the chest and shoulders.",
        "correction": "Maintain a stable torso angle and reduce the load to ensure the triceps drive the movement."
      },
      {
        "fault": "Cutting the range of motion short at the top or bottom.",
        "correction": "Allow full flexion to at least ninety degrees at the elbow and push to complete extension on every rep."
      }
    ],
    "safety": {
      "precautions": [
        "Avoid hyperextending or snapping the elbow joint at the bottom of the rep."
      ],
      "spotter": "not-needed"
    }
  },
