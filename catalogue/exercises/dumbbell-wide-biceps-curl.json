  "instructions": {
    "setup": [
      "Stand tall with feet hip-width apart, holding a dumbbell in each hand at your sides.",
      "Externally rotate your shoulders so your forearms flare outward at an angle away from your torso, with palms facing forward."
    ],
    "steps": [
      "Keeping your upper arms pinned to your sides and elbows stationary, curl the dumbbells upward along the wide trajectory toward your shoulders.",
      "Squeeze your biceps firmly at the top of the movement.",
      "Lower the dumbbells with control back to full elbow extension while maintaining the outward arm angle."
    ],
    "breathing": "Exhale as you curl the weights upward; inhale as you lower them under control.",
    "cues": [
      "Keep elbows tucked to your ribs.",
      "Curl out and up.",
      "Control the eccentric phase without swinging."
    ],
    "common_faults": [
      {
        "fault": "Swinging the torso to generate momentum.",
        "correction": "Brace your core and glutes, and select a load that allows strict elbow flexion without body english."
      },
      {
        "fault": "Letting the elbows drift forward or inward during the curl.",
        "correction": "Keep the elbows anchored at your sides and maintain external rotation throughout the entire rep."
      }
    ],
    "safety": {
      "precautions": [
        "Avoid hyperextending the lower back under heavy loads."
      ],
      "spotter": "not-needed"
    }
  },
