  "instructions": {
    "setup": [
      "Adjust the Smith machine bar height to approximately mid-thigh level.",
      "Stand facing the bar with feet hip-width apart and grasp the bar with a shoulder-width pronated grip.",
      "Rotate the bar to unrack it, standing upright with a braced core and arms fully extended."
    ],
    "steps": [
      "Elevate your shoulders straight up toward your ears in a smooth, controlled motion.",
      "Pause for a brief contraction at the top of the movement.",
      "Lower the bar under control until your traps are fully stretched back to the starting position."
    ],
    "breathing": "Exhale as you shrug your shoulders upward; inhale as you lower the weight under control.",
    "cues": [
      "Shrug straight up to the ears.",
      "Keep the elbows locked.",
      "Pause at the peak squeeze."
    ],
    "common_faults": [
      {
        "fault": "Rolling the shoulders in a circle at the top.",
        "correction": "Move strictly up and down along the vertical plane to prevent unnecessary glenohumeral stress."
      },
      {
        "fault": "Bending the elbows to pull the weight higher.",
        "correction": "Keep arms straight and rely entirely on scapular elevation."
      },
      {
        "fault": "Jutting the head forward during elevation.",
        "correction": "Keep the neck neutral and chin tucked throughout the set."
      }
    ],
    "safety": {
      "precautions": [
        "Ensure the safety catches on the Smith machine are engaged just below your lowest working range."
      ],
      "spotter": "not-needed",
      "safeties": true
    }
  },
