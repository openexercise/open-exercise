  "instructions": {
    "setup": [
      "Begin on all fours on hands and knees with your hands placed directly beneath your shoulders and knees under your hips.",
      "Tuck your toes and press through the balls of your feet to hover your knees one to two inches off the floor.",
      "Brace your core and maintain a flat, neutral spine."
    ],
    "steps": [
      "Step forward simultaneously with your right hand and left foot, keeping your movements short and controlled.",
      "Follow immediately by stepping forward with your left hand and right foot.",
      "Continue crawling forward in this contralateral pattern while keeping your hips level and knees hovering close to the ground."
    ],
    "breathing": "Breathe rhythmically and continuously through the nose and mouth while maintaining core brace.",
    "cues": [
      "Knees low to the ground",
      "Opposite hand and foot move together",
      "Keep hips quiet and flat like a tabletop"
    ],
    "common_faults": [
      {
        "fault": "Hips drifting excessively high into a pike position.",
        "correction": "Lower the hips and keep knees hovering just an inch or two above the floor."
      },
      {
        "fault": "Excessive side-to-side torso sway during steps.",
        "correction": "Shorten your stride length and brace the core to resist rotation."
      }
    ],
    "safety": {
      "precautions": [
        "Avoid if you have acute wrist pain or hyperextension discomfort unless modified on fists or parallettes."
      ],
      "spotter": "not-needed"
    }
  },
