  "id": "oec:seated-barbell-overhead-press",
  "instructions": {
    "setup": [
      "Set an adjustable bench to an upright or steep incline (roughly 75 to 85 degrees) inside a rack.",
      "Position the barbell on J-hooks at roughly chin height when seated.",
      "Sit back firmly against the pad with your feet planted flat on the floor.",
      "Grip the bar slightly wider than shoulder width with a full pronated grip, resting the bar across the heels of your palms.",
      "Unrack the barbell and hold it at upper chest height just below your chin, with elbows slightly forward of the bar."
    ],
    "steps": [
      "Brace your core and press the barbell vertically upward in a smooth, controlled path.",
      "Tuck your chin slightly as the bar passes your face, then push your head back to neutral as the bar clears your forehead.",
      "Lock out your elbows overhead with the bar positioned directly over your shoulders.",
      "Lower the barbell under control back to collarbone level, tracking your elbows slightly in front of your torso."
    ],
    "breathing": "Inhale and brace your core at the bottom before pressing, and exhale as you reach full lockout overhead.",
    "cues": [
      "Press through your palms",
      "Tuck the chin, then push through",
      "Elbows slightly forward, not flared",
      "Keep upper back pinned to the pad"
    ],
    "common_faults": [
      {
        "fault": "Excessively arching the lower back away from the bench.",
        "correction": "Keep your core tight and your hips and upper back firmly pressed against the backrest."
      },
      {
        "fault": "Flaring the elbows straight out to the sides.",
        "correction": "Keep your elbows tucked about 30 to 45 degrees in the scapular plane to protect the shoulder joint."
      },
      {
        "fault": "Bouncing the bar off the chest.",
        "correction": "Control the descent and pause briefly at collarbone level before pressing upward."
      }
    ],
    "safety": {
      "precautions": [
        "Set safety pins in the rack just below chin level to catch the barbell if a rep is missed.",
        "Avoid using a false or thumbless grip to prevent the bar from slipping."
      ],
      "spotter": "recommended",
      "safeties": true
    }
  },
