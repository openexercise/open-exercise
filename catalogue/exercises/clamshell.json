  "instructions": {
    "setup": [
      "Lie on your side on the floor or a mat, resting your head comfortably on your bottom arm.",
      "Bend your hips to approximately 45 degrees and your knees to roughly 90 degrees.",
      "Stack your shoulders, hips, knees, and feet vertically perpendicular to the floor."
    ],
    "steps": [
      "Engage your core to prevent your pelvis from rocking backward.",
      "Keeping your heels pressed together, raise your top knee as high as you comfortably can using your hip muscles.",
      "Pause for a moment at the top of the movement to emphasize the contraction in the upper glute.",
      "Slowly lower your top knee back down until it touches the resting knee."
    ],
    "breathing": "Exhale as you raise the knee upward and inhale as you lower it back to the start.",
    "cues": [
      "Keep heels glued together",
      "Do not let your hips roll back",
      "Squeeze the side of your hip at the top"
    ],
    "common_faults": [
      {
        "fault": "Rolling the pelvis backward during the lift",
        "correction": "Place your top hand on your hip bone to monitor pelvis position, and stop raising the knee before the pelvis starts tilting."
      },
      {
        "fault": "Separating the feet during the repetition",
        "correction": "Keep your inner heels lightly pressed together throughout the entire range of motion."
      }
    ],
    "safety": {
      "spotter": "not-needed"
    }
  },
