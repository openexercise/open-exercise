  "id": "oec:wall-biceps-stretch",
  "instructions": {
    "setup": [
      "Stand sideways next to a wall with your feet hip-width apart.",
      "Extend the arm closest to the wall straight behind you at approximately shoulder height.",
      "Place your palm flat against the wall, pointing your fingers directly behind you or slightly downward."
    ],
    "steps": [
      "Keep your arm extended and your shoulder packed down away from your ear.",
      "Slowly rotate your chest and torso away from the wall until you feel a gentle stretch across the front of your arm and shoulder.",
      "Hold the position steadily without bouncing.",
      "Gently rotate back toward the wall to release the tension, then switch sides."
    ],
    "breathing": "Breathe smoothly and deeply, relaxing deeper into the stretch with each exhalation.",
    "cues": [
      "Keep the shoulder down",
      "Turn your chest away",
      "Maintain a straight arm"
    ],
    "common_faults": [
      {
        "fault": "Shrugging the shoulder up toward the ear",
        "correction": "Depress the shoulder blade down and back before rotating your torso."
      },
      {
        "fault": "Bending the working elbow",
        "correction": "Keep the arm fully extended to ensure the stretch reaches the biceps rather than only the chest."
      },
      {
        "fault": "Aggressively forcing the torso rotation",
        "correction": "Rotate gradually and stop at a comfortable, pain-free stretch sensation."
      }
    ],
    "safety": {
      "precautions": [
        "Avoid this stretch if you experience sharp anterior shoulder impingement or pain."
      ],
      "spotter": "not-needed"
    }
  },
