  "id": "oec:cable-single-arm-row",
  "instructions": {
    "setup": [
      "Attach a single D-handle to a low or mid pulley on a cable station.",
      "Sit upright facing the machine on the row bench or an upright utility bench, placing your feet securely on the footrests or floor.",
      "Grasp the handle with one hand in a neutral grip and sit tall with your chest up and arm fully extended to establish tension on the cable."
    ],
    "steps": [
      "Initiate the pull by retracting and depressing your shoulder blade.",
      "Drive your elbow straight back toward your hip, keeping the forearm aligned with the cable.",
      "Pull until your hand reaches your lower ribs or hip, squeezing your lat firmly at the peak contraction.",
      "Slowly extend your arm and allow your shoulder blade to protract under control to achieve a deep stretch in the lat before starting the next repetition."
    ],
    "breathing": "Exhale as you row the handle toward your torso, and inhale as you return the weight under control.",
    "cues": [
      "Lead with the elbow.",
      "Pull your elbow to your hip pocket.",
      "Keep your torso square and avoid twisting."
    ],
    "common_faults": [
      {
        "fault": "Excessive torso rotation to heave the weight.",
        "correction": "Brace your core and keep your shoulders and chest facing forward throughout the movement."
      },
      {
        "fault": "Shrugging the shoulder toward the ear during the pull.",
        "correction": "Keep your shoulder depressed down and away from your ear as you pull."
      }
    ],
    "safety": {
      "precautions": [
        "Maintain a neutral spine and avoid rounding the lower back when reaching into the stretched position."
      ],
      "spotter": "not-needed"
    }
  },
