  "instructions": {
    "setup": [
      "Stand tall with your feet placed shoulder-width apart and your hands resting on your hips.",
      "Keep a soft, slight bend in your knees to allow smooth movement through the pelvis."
    ],
    "steps": [
      "Shift your hips forward, then sweep them smoothly out to one side, backward, and around to the other side.",
      "Trace continuous, controlled circular motions for the desired number of repetitions.",
      "Pause, reverse direction, and perform an equal number of circles on the opposite side."
    ],
    "breathing": "Breathe smoothly and rhythmically without holding your breath throughout the circles.",
    "cues": [
      "Draw a wide circle with your belt line.",
      "Keep your torso upright and relaxed.",
      "Soft knees, smooth circles."
    ],
    "common_faults": [
      {
        "fault": "Swinging the upper torso excessively instead of moving the hips.",
        "correction": "Keep your chest relatively tall and focus movement on rotating the pelvis and hips."
      },
      {
        "fault": "Locking out the knees completely.",
        "correction": "Maintain a soft knee bend so the hips can move through their full, comfortable range."
      }
    ],
    "safety": {
      "precautions": [
        "Stay within a comfortable range of motion and avoid forcing deep hip pinching or lower-back hyperextension."
      ],
      "spotter": "not-needed"
    }
  },
