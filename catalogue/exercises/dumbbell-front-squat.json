  "instructions": {
    "setup": [
      "Stand with feet roughly shoulder-width apart, toes turned slightly outward.",
      "Clean or lift two dumbbells to rest one end of each dumbbell on the front of your shoulders, with elbows pointing forward and slightly up."
    ],
    "steps": [
      "Brace your core and initiate the descent by bending at your knees and hips simultaneously.",
      "Lower your hips under control until your thighs reach at least parallel to the floor, keeping your torso upright and elbows elevated.",
      "Push through your midfoot and heels to reverse the movement and stand back up to full hip and knee extension."
    ],
    "breathing": "Inhale and brace your core before descending; exhale as you push past the sticking point on the ascent.",
    "cues": [
      "Keep the elbows high.",
      "Sit between your heels.",
      "Stay tall through the torso."
    ],
    "common_faults": [
      {
        "fault": "Elbows dropping, causing the chest to collapse forward.",
        "correction": "Actively drive your elbows up throughout the squat to keep the upper back extended."
      },
      {
        "fault": "Heels lifting off the floor during the descent.",
        "correction": "Distribute weight evenly across the entire foot and work on ankle dorsiflexion mobility or elevate heels slightly."
      },
      {
        "fault": "Knees caving inward (valgus collapse) on the ascent.",
        "correction": "Track your knees in line with your toes throughout the movement."
      }
    ],
    "safety": {
      "precautions": [
        "If you lose balance or reach failure, safely dump the dumbbells forward away from your body onto the floor."
      ],
      "spotter": "not-needed"
    }
  },
