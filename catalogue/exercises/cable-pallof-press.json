  "instructions": {
    "setup": [
      "Set a cable pulley to chest height and attach a single D-handle.",
      "Stand perpendicular to the cable machine, holding the handle with both hands clasped around it.",
      "Step away from the stack to create tension and assume an athletic, shoulder-width stance with knees slightly bent."
    ],
    "steps": [
      "Begin with the hands held tight against the center of the chest.",
      "Brace the core and press the handle straight out in front of the sternum until arms are fully extended.",
      "Pause for one to two seconds at full lockout, resisting any rotational pull toward the weight stack.",
      "Slowly bring the hands back to the chest with control to complete the rep."
    ],
    "breathing": "Inhale with hands at the chest, brace, and exhale steadily as you press forward and maintain the lockout.",
    "cues": [
      "Lock your hips forward.",
      "Press in a straight line.",
      "Do not let the cable twist you."
    ],
    "common_faults": [
      {
        "fault": "Rotating the shoulders or pelvis toward the machine during the press.",
        "correction": "Square your hips and shoulders forward and reduce the load if rotation occurs."
      },
      {
        "fault": "Pressing on an upward or downward angle.",
        "correction": "Ensure the pulley is at sternum height and press directly forward in a horizontal line."
      },
      {
        "fault": "Rushing through reps without pausing at full extension.",
        "correction": "Hold lockout for at least one second where the lever arm and anti-rotational challenge are highest."
      }
    ],
    "safety": {
      "precautions": [
        "Avoid using excessive loads that force the lumbar spine into twisting under tension."
      ],
      "spotter": "not-needed"
    }
  },
