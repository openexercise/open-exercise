  "id": "oec:machine-shoulder-press",
  "instructions": {
    "setup": [
      "Adjust the seat height so the machine handles sit roughly level with your chin or mid-neck.",
      "Sit back firmly against the back pad with your feet flat on the floor.",
      "Grasp the handles with an overhand or neutral grip, keeping your wrists neutral and elbows positioned slightly in front of your body."
    ],
    "steps": [
      "Press the handles upward and slightly diagonally along the guided path until your arms are extended without forcefully locking out your elbows.",
      "Pause briefly at the top while maintaining tension across your shoulders.",
      "Lower the handles under control until your hands return to roughly ear height before beginning the next repetition."
    ],
    "breathing": "Inhale as you lower the weight toward your shoulders, and exhale as you press overhead.",
    "cues": [
      "Keep your upper back pinned to the pad",
      "Drive straight up through the handles",
      "Control the descent, don't let the stack slam"
    ],
    "common_faults": [
      {
        "fault": "Excessively arching the lower back to turn the movement into an incline chest press.",
        "correction": "Keep your glutes and upper back firmly against the pad and brace your abdominals throughout the press."
      },
      {
        "fault": "Setting the seat too low, forcing the shoulders into extreme, uncomfortable abduction at the start.",
        "correction": "Raise the seat so the handles align between shoulder and chin level at the bottom."
      }
    ],
    "safety": {
      "precautions": [
        "Use the machine foot pedal if available to bring the handles into starting position safely."
      ],
      "spotter": "not-needed"
    }
  },
