  "instructions": {
    "setup": [
      "Stand with feet hip-width apart, holding a light dumbbell in each hand.",
      "Hinge forward at the hips until your torso is nearly parallel to the floor, maintaining a flat back and soft bend in the knees.",
      "Let your arms hang straight down below your chest with palms facing each other and elbows slightly unlocked."
    ],
    "steps": [
      "Maintain a fixed, slight bend in the elbows and raise the dumbbells out to the sides in a wide arc.",
      "Continue raising until your upper arms are in line with your torso, feeling the contraction in the rear shoulders.",
      "Pause briefly at the peak of the movement.",
      "Lower the dumbbells smoothly along the same arc back to the starting hanging position."
    ],
    "breathing": "Exhale as you raise the dumbbells outward; inhale as you return to the starting position.",
    "cues": [
      "Lead with the elbows",
      "Keep torso stationary",
      "Pour water at the top"
    ],
    "common_faults": [
      {
        "fault": "Swinging the torso to generate momentum.",
        "correction": "Reduce the dumbbell weight and keep your hips and spine rigid throughout each repetition."
      },
      {
        "fault": "Excessively bending the elbows into a row.",
        "correction": "Lock a slight elbow bend from the start and move only through the shoulder joints."
      },
      {
        "fault": "Rounding the lower back.",
        "correction": "Hinge deeply at the hips and engage the core and spinal erectors to maintain a neutral spine."
      }
    ],
    "safety": {
      "precautions": [
        "Use light weights to protect shoulder integrity and avoid recruiting larger muscle groups like the lats."
      ],
      "spotter": "not-needed"
    }
  },
