  "id": "oec:cable-scapular-retraction",
  "instructions": {
    "setup": [
      "Sit upright at a low cable row station with your feet firmly planted on the footrests and knees slightly bent.",
      "Grasp the handle attachment with arms fully extended and your torso vertical.",
      "Allow the resistance to pull your shoulder blades forward into a fully protracted position while maintaining an upright, neutral spine."
    ],
    "steps": [
      "Keeping your arms straight, smoothly pull your shoulder blades straight back toward your spine.",
      "Hold the fully retracted position for a brief pause, focusing on contracting your middle back.",
      "Slowly allow your shoulder blades to glide forward into full protraction under control."
    ],
    "breathing": "Exhale as you retract your shoulder blades, and inhale as you allow them to protract forward.",
    "cues": [
      "Pinch a pencil between your shoulder blades.",
      "Keep your arms locked long; do not bend at the elbows.",
      "Stay tall and do not rock through your torso."
    ],
    "common_faults": [
      {
        "fault": "Bending the elbows to pull the weight.",
        "correction": "Keep your arms extended with only a soft micro-bend in the elbows so all movement originates from the shoulder blades."
      },
      {
        "fault": "Swinging the torso backward to create momentum.",
        "correction": "Brace your core and keep your torso stationary, moving only your scapulae."
      }
    ],
    "safety": {
      "precautions": [
        "Avoid shrugging your shoulders upward toward your ears to prevent overworking the upper trapezius and neck."
      ],
      "spotter": "not-needed"
    }
  },
