  "instructions": {
    "setup": [
      "Stand tall with feet hip-width apart and knees unlocked.",
      "Hold a dumbbell in each hand resting against the front of your thighs with a pronated grip (palms facing your body).",
      "Engage your core, pull your shoulders back slightly, and maintain a soft, fixed bend in your elbows."
    ],
    "steps": [
      "Raise the dumbbells straight out in front of your body in the sagittal plane until your arms are parallel to the floor.",
      "Pause momentarily at shoulder height while maintaining control and keeping your torso upright.",
      "Lower the dumbbells smoothly back down to the starting position along the same path."
    ],
    "breathing": "Exhale as you raise the dumbbells up to shoulder level, and inhale as you lower them with control.",
    "cues": [
      "Lead with your knuckles.",
      "Lock your torso in place.",
      "Do not swing the hips."
    ],
    "common_faults": [
      {
        "fault": "Swinging the torso and using hip momentum to heave the dumbbells upward.",
        "correction": "Reduce the load and keep the glutes and abdominals braced to isolate the shoulders."
      },
      {
        "fault": "Hyperextending the lower back at the top of the lift.",
        "correction": "Maintain a neutral spine and stop raising the dumbbells once they reach eye or shoulder height."
      },
      {
        "fault": "Excessively bending and extending the elbows during the movement.",
        "correction": "Keep a static, slight bend in the elbows throughout the entire repetition."
      }
    ],
    "safety": {
      "precautions": [
        "Avoid raising the weights significantly above shoulder level if you experience anterior shoulder impingement or pain."
      ],
      "spotter": "not-needed"
    }
  },
