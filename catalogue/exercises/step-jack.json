  "instructions": {
    "setup": [
      "Stand tall with feet together and arms resting comfortably at your sides.",
      "Engage your core and keep your chest lifted with a slight, soft bend in your knees."
    ],
    "steps": [
      "Step your right foot out to the side while simultaneously sweeping both arms out and overhead.",
      "Tap the right toe lightly, then step the right foot back to center as you lower your arms to your sides.",
      "Immediately step your left foot out to the opposite side while raising your arms overhead once again.",
      "Return the left foot to center and continue alternating sides in a smooth, continuous rhythm."
    ],
    "breathing": "Breathe rhythmically throughout, inhaling as you step out and exhaling as you return to center.",
    "cues": [
      "Light on your toes",
      "Big arm sweeps overhead",
      "Keep a steady rhythm"
    ],
    "common_faults": [
      {
        "fault": "Slumping or leaning excessively toward the stepping side.",
        "correction": "Keep your torso upright and core braced rather than shifting your entire upper body laterally."
      },
      {
        "fault": "Cutting the arm path short.",
        "correction": "Bring your hands all the way overhead with full shoulder abduction on each repetition."
      }
    ],
    "safety": {
      "precautions": [
