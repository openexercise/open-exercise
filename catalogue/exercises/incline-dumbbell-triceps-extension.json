  "id": "oec:incline-dumbbell-triceps-extension",
  "instructions": {
    "setup": [
      "Set an adjustable bench to an incline of approximately 30 to 45 degrees.",
      "Sit back firmly against the pad with feet flat on the floor.",
      "Raise a pair of dumbbells overhead with a neutral grip (palms facing each other), extending your arms so the upper arms are angled slightly back past perpendicular to your torso."
    ],
    "steps": [
      "Keep your upper arms stationary and bend your elbows to lower the dumbbells in a controlled arc behind your head.",
      "Lower until your elbows reach approximately 90 degrees or you feel a deep stretch in your triceps.",
      "Extend your elbows smoothly by contracting your triceps to return the dumbbells to the starting position without locking out aggressively."
    ],
    "breathing": "Inhale as you lower the weights behind your head and exhale as you extend your elbows to return to the top.",
    "cues": [
      "Keep your elbows pointed forward, not flared wide.",
      "Pin your upper arms in place; move only the forearms.",
      "Control the descent for a full triceps stretch."
    ],
    "common_faults": [
      {
        "fault": "Flaring the elbows outward excessively.",
        "correction": "Keep elbows aligned roughly shoulder-width apart to keep tension on the triceps and reduce stress on the shoulder joint."
      },
      {
        "fault": "Swinging the upper arms forward and back to gain momentum.",
        "correction": "Lock the shoulders into a stable angle and isolate movement strictly to the elbow joint."
      }
    ],
    "safety": {
      "precautions": [
        "Use a manageable load to avoid accidental contact with the head or overstraining the elbow tendons."
      ],
      "spotter": "not-needed"
    }
  },
