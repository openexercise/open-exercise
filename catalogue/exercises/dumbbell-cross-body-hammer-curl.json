  "instructions": {
    "setup": [
      "Stand tall with feet hip-width apart and knees slightly unlocked.",
      "Hold a dumbbell in each hand at your sides with palms facing your torso in a neutral grip.",
      "Engage your core and pull your shoulder blades slightly back and down."
    ],
    "steps": [
      "Keeping the upper arm stable and palm facing inward, curl one dumbbell across your torso toward the opposite clavicle or shoulder.",
      "Squeeze the arm flexors firmly at the peak of the movement.",
      "Lower the dumbbell under control along the same diagonal path back to your side.",
      "Repeat the movement with the opposite arm and alternate sides for the target repetitions."
    ],
    "breathing": "Exhale while curling the dumbbell across your body, and inhale as you lower it with control.",
    "cues": [
      "Curl toward the opposite shoulder",
      "Keep palms facing inward throughout",
      "Lock the upper arm in place"
    ],
    "common_faults": [
      {
        "fault": "Swinging the torso to generate momentum.",
        "correction": "Brace the core, keep hips stationary, and choose a lighter dumbbell if needed."
      },
      {
        "fault": "Allowing the elbow to flare outward or drift excessively forward.",
        "correction": "Keep the upper arm pinned near the ribcage so the elbow acts as a fixed hinge."
      },
      {
        "fault": "Supinating the wrist during the lift.",
        "correction": "Maintain a strict neutral hammer grip throughout the entire repetition."
      }
    ],
    "safety": {
      "precautions": [
        "Avoid hyperextending the spine while lifting."
      ],
      "spotter": "not-needed"
    }
  },
