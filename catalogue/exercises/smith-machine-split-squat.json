  "instructions": {
    "setup": [
      "Set the Smith machine bar to roughly mid-chest height and position the safety stoppers at an appropriate depth.",
      "Step under the bar and rest it across your upper trapezius, grasping it firmly with an overhand grip.",
      "Step one foot forward and the other back into a split stance, hip-width apart for balance, and unhook the bar by rotating the wrists."
    ],
    "steps": [
      "Lower your body under control by bending both knees until the front thigh is approximately parallel to the floor and the rear knee hovers just above the ground.",
      "Drive through the midfoot and heel of the front foot to extend the hips and knees back to the starting position.",
      "Complete the desired repetitions on one side, re-rack the bar or switch foot placement, and repeat with the opposite leg forward."
    ],
    "breathing": "Inhale as you descend into the split squat; exhale forcefully as you drive up through the front leg.",
    "cues": [
      "Drive through the front heel",
      "Keep torso tall",
      "Track front knee over toes"
    ],
    "common_faults": [
      {
        "fault": "Positioning feet in a tight single line, compromising balance.",
        "correction": "Maintain hip-width separation between the feet in the split stance."
      },
      {
        "fault": "Pushing primarily off the back foot rather than loading the front leg.",
        "correction": "Keep roughly 70-80% of your body weight centered over the front leg."
      }
    ],
    "safety": {
      "precautions": [
        "Set the safety catches to just below your lowest working depth before loading weight."
      ],
      "spotter": "not-needed",
      "safeties": true
    }
  },
