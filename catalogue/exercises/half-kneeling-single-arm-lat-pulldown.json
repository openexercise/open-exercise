  "id": "oec:half-kneeling-single-arm-lat-pulldown",
  "instructions": {
    "setup": [
      "Attach a single D-handle to a high cable pulley.",
      "Assume a half-kneeling position facing the cable stack, resting the knee on the floor on the same side as the working arm.",
      "Place the front foot flat on the floor with hip and knee bent at ninety-degree angles.",
      "Reach up with the working hand and grasp the handle with a neutral grip, keeping your torso upright, ribs down, and hips square."
    ],
    "steps": [
      "Depress your scapula and drive your elbow down toward your hip pocket to initiate the pull.",
      "Continue pulling until your hand reaches roughly upper-chest height and your lat is fully contracted.",
      "Pause momentarily at the bottom without twisting or side-bending your torso.",
      "Control the weight as you slowly extend your arm back overhead, allowing your scapula to elevate and stretch the lat."
    ],
    "breathing": "Inhale as your arm extends overhead; exhale as you pull the handle down to your side.",
    "cues": [
      "Drive your elbow to your hip pocket.",
      "Keep your belt buckle pointed straight ahead.",
      "Squeeze your rear glute to keep your pelvis stable."
    ],
    "common_faults": [
      {
        "fault": "Rotating or leaning the torso toward the working side to cheat the weight down.",
        "correction": "Brace the core, squeeze the rear glute, and keep the chest and pelvis facing forward throughout the entire rep."
      },
      {
        "fault": "Pulling the elbow excessively behind the body, leading to anterior shoulder glide.",
        "correction": "Stop the pull once your elbow aligns with your torso, focusing tension entirely on the latissimus dorsi."
      }
    ],
    "safety": {
      "precautions": [
        "Place a pad or mat under the kneeling knee to protect the patella."
      ],
      "spotter": "not-needed"
    }
  },
