  "instructions": {
    "setup": [
      "Loop a resistance band through the handle of a kettlebell and pull it tight to create a secure hitch.",
      "Stand tall and grip the looped band with one hand, lifting the kettlebell off the floor so it hangs suspended at your side.",
      "Engage your core to set your shoulders and hips level before lifting one foot slightly off the floor."
    ],
    "steps": [
      "Hold your torso upright and stationary, actively resisting the lateral pull and oscillation of the bouncing weight.",
      "Maintain single-leg balance on the standing leg for the prescribed time, or slowly alternate standing legs without losing pelvic stability.",
      "Carefully lower the raised foot, set the kettlebell down, and repeat the hold on the opposite side."
    ],
    "breathing": "Breathe in a controlled, rhythmic pattern behind a braced abdominal wall throughout the hold.",
    "cues": [
      "Keep your shoulders level.",
      "Crush the band handle.",
      "Brace against the bounce."
    ],
    "common_faults": [
      {
        "fault": "Leaning away from or toward the loaded side to compensate for the weight.",
        "correction": "Keep the spine vertical and maintain equal distance between your ribcage and pelvis on both sides."
      },
      {
        "fault": "Allowing the hips to drop on the unsupported leg side.",
        "correction": "Actively squeeze the glute of the stance leg to keep the pelvis level."
      }
    ],
    "safety": {
      "precautions": [
        "Inspect the resistance band for tears or wear before suspending the kettlebell.",
        "Ensure adequate clear floor space in case the weight swings or balance is lost."
      ],
      "spotter": "not-needed"
    }
  },
