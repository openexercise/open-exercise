  "instructions": {
    "setup": [
      "Sit on the edge of a flat bench with your feet flat on the floor and close together.",
      "Hold a dumbbell in each hand, then hinge forward at the hips until your torso rests on or near your thighs, letting your arms hang down beside your calves with a slight bend in the elbows."
    ],
    "steps": [
      "Maintain a fixed slight bend in your elbows and brace your core.",
      "Raise the dumbbells outward and upward in a wide arc until your upper arms are roughly parallel to the floor.",
      "Pause briefly at the peak of the contraction, focusing on squeezing the rear shoulders.",
      "Lower the dumbbells under control along the same path back to the starting position."
    ],
    "breathing": "Exhale as you raise the dumbbells out to the sides, and inhale as you lower them with control.",
    "cues": [
      "Lead with your elbows, not your hands.",
      "Reach wide toward the walls rather than just pulling back.",
      "Keep your torso still and avoid swinging your back up."
    ],
    "common_faults": [
      {
        "fault": "Swinging the upper body to create momentum.",
        "correction": "Keep your torso pinned to your thighs and use lighter dumbbells to isolate the posterior deltoids."
      },
      {
        "fault": "Excessive elbow bending turning the movement into a row.",
        "correction": "Lock a slight bend in your elbows and maintain that exact angle throughout the entire repetition."
      },
      {
        "fault": "Shrugging the shoulders up toward the ears.",
        "correction": "Keep your shoulder blades depressed away from your ears to prevent overusing the upper trapezius."
      }
    ],
    "safety": {
      "precautions": [
        "Select moderate to light loads; overloading rear delt raises frequently compromises form and strains the neck or lower back."
      ],
      "spotter": "not-needed"
    }
  },
