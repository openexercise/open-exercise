  "id": "oec:mountain-climber",
  "instructions": {
    "setup": [
      "Place your hands flat on the floor directly beneath your shoulders with fingers spread slightly.",
      "Extend your legs behind you onto the balls of your feet, establishing a solid high plank position.",
      "Brace your core, squeeze your glutes, and maintain a straight line from your head to your heels."
    ],
    "steps": [
      "Drive one knee forward toward your chest in a straight line without letting your hips pike upward.",
      "Quickly switch legs by extending the front leg back while simultaneously driving the opposite knee toward your chest.",
      "Continue alternating legs in a smooth, rhythmic running motion while keeping your shoulders stacked over your wrists."
    ],
    "breathing": "Breathe continuously and rhythmically throughout the set, avoiding holding your breath.",
    "cues": [
      "Hands glued under shoulders",
      "Hips down",
      "Drive knees to chest",
      "Pace your rhythm"
    ],
    "common_faults": [
      {
        "fault": "Piking the hips up into a pike or downward dog position.",
        "correction": "Keep your core braced and shoulders directly over your wrists to maintain a flat plank profile."
      },
      {
        "fault": "Letting the lower back sag into hyperextension.",
        "correction": "Engage your abdominal wall and slightly tuck your pelvis to keep the lumbar spine neutral."
      },
      {
        "fault": "Bouncing aggressively off the toes, rocking the upper body forward and back.",
        "correction": "Isolate the movement to the lower body, keeping the torso and shoulder girdle completely stable."
      }
    ],
    "safety": {
      "precautions": [
        "Ensure the floor surface is non-slip so your hands and feet do not slide during dynamic movement."
      ],
      "spotter": "not-needed"
    }
  },
