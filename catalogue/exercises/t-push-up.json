  "id": "oec:t-push-up",
  "instructions": {
    "setup": [
      "Assume a high plank position with your hands slightly wider than shoulder-width apart and your feet set about shoulder-width apart for rotational stability.",
      "Engage your abdominals and glutes to align your body in a straight line from head to heels."
    ],
    "steps": [
      "Lower your chest toward the floor by bending your elbows back at roughly a 45-degree angle.",
      "Push forcefully through your palms to return to the top of the push-up.",
      "At lockout, shift your weight onto your left hand and pivot on the edges of your feet, rotating your torso open to the right.",
      "Raise your right arm straight toward the ceiling until your arms and chest form a vertical 'T' shape.",
      "Pause briefly in control, then rotate back down to the starting high plank position.",
      "Perform the next push-up and rotate to the opposite side."
    ],
    "breathing": "Inhale as you lower into the push-up, exhale as you press up and rotate into the T-position.",
    "cues": [
      "Keep your body in a rigid plank throughout the rotation.",
      "Follow your top hand with your gaze.",
      "Drive the floor away with the supporting shoulder so it does not collapse."
    ],
    "common_faults": [
      {
        "fault": "Sagging or hiking the hips during the rotation.",
        "correction": "Squeeze your obliques and glutes to keep the pelvis aligned with your spine throughout the transition."
      },
      {
        "fault": "Feet set too close together.",
        "correction": "Widen your stance to shoulder width to allow smooth pivoting onto the sides of your feet."
      },
      {
        "fault": "Rushing the rotation and losing balance.",
        "correction": "Complete the push-up lockout first before initiating a deliberate, controlled turn of the torso."
      }
    ],
    "safety": {
      "precautions": [
        "Avoid if experiencing acute shoulder impingement or wrist pain."
      ],
      "spotter": "not-needed"
    }
  },
