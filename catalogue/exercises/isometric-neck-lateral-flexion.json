  "id": "oec:isometric-neck-lateral-flexion",
  "instructions": {
    "setup": [
      "Sit upright in a chair or stand with a tall, neutral spine and relaxed shoulders.",
      "Place the palm of one hand flat against the side of your head, just above the ear."
    ],
    "steps": [
      "Gently press your head sideways toward your hand while pressing back with equal force with your palm so no movement occurs.",
      "Hold the isometric contraction steadily for the intended duration.",
      "Gradually ease off the pressure and return to neutral before performing on the other side."
    ],
    "breathing": "Breathe smoothly and continuously throughout the contraction without holding your breath.",
    "cues": [
      "Match the force evenly",
      "Keep shoulders down",
      "Breathe through the hold"
    ],
    "common_faults": [
      {
        "fault": "Shrugging the shoulder toward the ear during the press.",
        "correction": "Actively keep both shoulders depressed and relaxed throughout the hold."
      },
      {
        "fault": "Pushing with excessive force causing strain or head deviation.",
        "correction": "Apply gentle, submaximal pressure and ensure your head remains completely stationary."
      }
    ],
    "safety": {
      "precautions": [
        "Begin with light resistance to avoid cervical strain.",
        "Stop immediately if you experience dizziness, sharp pain, or tingling radiating down the arm."
      ],
      "spotter": "not-needed"
    }
  },
