  "instructions": {
    "setup": [
      "Adjust the seat height so that the close-grip handles are aligned with your lower rib cage or mid-torso.",
      "If the machine has a chest pad, adjust it so your arms are fully extended at the start with the weight stack slightly disengaged.",
      "Sit upright with your feet planted firmly on the floor or footrests, and grasp the narrow handles."
    ],
    "steps": [
      "Initiate the pull by driving your elbows backward tight against your ribs while retracting your shoulder blades.",
      "Continue pulling until your hands reach the sides of your torso, squeezing your back muscles firmly.",
      "Reverse the motion under control, extending your arms and allowing your scapulae to protract slightly for a full stretch.",
      "Repeat for the desired number of repetitions without letting the weight stack slam between reps."
    ],
    "breathing": "Exhale as you pull the handles toward your torso; inhale as you return the handles to the starting position.",
    "cues": [
      "Drive the elbows back.",
      "Keep your chest tall.",
      "Pinch your shoulder blades at the finish."
    ],
    "common_faults": [
      {
        "fault": "Leaning back excessively to generate momentum.",
        "correction": "Keep your torso stable and upright, letting the back muscles do the work rather than rocking."
      },
      {
        "fault": "Shrugging the shoulders up toward the ears.",
        "correction": "Depress your shoulders and focus on pulling low toward the waist."
      },
      {
        "fault": "Flaring elbows out wide.",
        "correction": "Keep the elbows tucked close to your ribcage to maximize lat recruitment with the close grip."
      }
    ],
    "safety": {
      "precautions": [
        "Maintain control of the weight stack throughout the entire range of motion to avoid sudden strain on the shoulders or spine."
      ],
      "spotter": "not-needed"
    }
  },
