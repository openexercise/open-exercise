  "instructions": {
    "setup": [
      "Adjust the thigh pad on the lat pulldown machine so your knees fit snugly and your feet rest flat on the floor.",
      "Grasp the lat pulldown bar with a pronated grip slightly wider than shoulder width.",
      "Sit down under the pads, extend your arms overhead, and lean your torso back roughly 30 to 45 degrees with your chest held high and spine neutral."
    ],
    "steps": [
      "Initiate the pull by drawing your shoulder blades down and back.",
      "Pull the bar down toward your mid-to-upper chest while driving your elbows downward and behind your torso.",
      "Pause briefly at the bottom to actively squeeze your lats and mid-back musculature.",
      "Control the ascent as you allow the bar to return overhead, maintaining the fixed torso angle throughout the repetition."
    ],
    "breathing": "Inhale as your arms extend overhead, and exhale smoothly as you pull the bar down toward your chest.",
    "cues": [
      "Drive elbows down and back",
      "Chest up to the bar",
      "Hold your torso angle steady"
    ],
    "common_faults": [
      {
        "fault": "Swinging the torso dynamically back and forth to generate momentum.",
        "correction": "Lock your torso into a fixed 30 to 45 degree lean before the rep begins and keep it stationary."
      },
      {
        "fault": "Pulling primarily with the biceps without engaging the back.",
        "correction": "Initiate the repetition by depressing the scapulae before bending your elbows."
      }
    ],
    "safety": {
      "spotter": "not-needed"
    }
