  "id": "oec:running",
  "instructions": {
    "setup": [
      "Stand tall with your head facing forward, shoulders relaxed, and arms bent at roughly ninety degrees.",
      "Engage your core lightly and lean slightly forward from your ankles, not your waist."
    ],
    "steps": [
      "Push off the ground with one foot to initiate forward propulsion, driving the opposite knee forward and upward.",
      "Land softly under your center of mass with your midfoot or forefoot, keeping your knee slightly flexed to absorb impact.",
      "Swing your arms rhythmically front-to-back in opposition to your leg drive to maintain balance and momentum.",
      "Cycle continuously through alternating stance and flight phases across the desired distance or duration."
    ],
    "breathing": "Breathe rhythmically and deeply in sync with your stride pattern (such as inhaling for two strides and exhaling for two strides).",
    "cues": [
      "Stay tall with a slight lean from the ankles",
      "Land softly underneath your hips",
      "Drive elbows back, not across the body",
      "Keep your cadence light and quick"
    ],
    "common_faults": [
      {
        "fault": "Overstriding, where the foot lands far in front of the center of mass with a locked knee.",
        "correction": "Shorten your stride and increase cadence so your feet land directly beneath your hips."
      },
      {
        "fault": "Excessive arm crossover across the chest, causing wasted rotational energy.",
        "correction": "Drive the elbows straight back and keep hands relaxed moving forward and backward."
      },
      {
        "fault": "Bending forward at the waist or slouching through the shoulders.",
        "correction": "Keep your chest proud, gaze fixed toward the horizon, and hinge forward slightly from the ankles."
      }
    ],
    "safety": {
      "precautions": [
        "Wear appropriate running shoes tailored to your foot strike and surface.",
        "Gradually increase mileage and intensity to avoid overuse injuries such as shin splints or tendinopathies."
      ],
      "spotter": "not-needed"
    }
  },
