  "instructions": {
    "setup": [
      "Grip the barbell using a wide snatch grip and press or jerk it directly overhead.",
      "Lock out the elbows fully and push up actively against the bar with your shoulders.",
      "Position your feet shoulder-width apart with toes turned slightly outward and brace your core."
    ],
    "steps": [
      "Descend by breaking at the hips and knees simultaneously while keeping your chest tall and the bar centered over midfoot.",
      "Squat down until the hip crease descends below the tops of the knees, ensuring elbows remain locked.",
      "Drive through the whole foot to stand up, pressing actively into the barbell throughout the ascent.",
      "Return to a fully locked-out standing position before beginning the next repetition."
    ],
    "breathing": "Take a deep breath and brace firmly into the abdomen before descending; hold pressure through the turn and exhale once past the sticking point on the ascent.",
    "cues": [
      "Push the bar to the ceiling",
      "Armpits facing forward",
      "Squat straight down between your ankles"
    ],
    "common_faults": [
      {
        "fault": "Letting the bar drift forward during the descent.",
        "correction": "Push up actively into the barbell and maintain thoracic extension to keep the load stacked over midfoot."
      },
      {
        "fault": "Soft or bending elbows under load.",
        "correction": "Actively lock out the triceps and elevate the shoulder blades continuously."
      },
      {
        "fault": "Collapsing knees inward during the squat.",
        "correction": "Track your knees in line with your toes and open the hips as you sink into the bottom."
      }
    ],
    "safety": {
      "precautions": [
        "Perform on a lifting platform using bumper plates so the barbell can be safely dumped forward or backward if balance is lost.",
        "Never perform with a spotter behind or in front of the lifter."
      ],
      "spotter": "not-needed"
    }
  },
