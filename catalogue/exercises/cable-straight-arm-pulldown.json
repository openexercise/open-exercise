  "instructions": {
    "setup": [
      "Attach a straight bar or wide handle to the high pulley of a cable station.",
      "Grasp the bar with an overhand, shoulder-width grip.",
      "Step back a couple of feet to create tension on the cable, hinge forward slightly at the hips, and maintain a soft bend in your knees and elbows."
    ],
    "steps": [
      "Keeping your arms fixed with only a slight, unchanging bend at the elbows, pull the bar down in a sweeping arc toward your thighs.",
      "Contract your lats firmly as the bar approaches your hips.",
      "Control the bar as it travels back along the same path overhead until you feel a deep stretch in your lats.",
      "Stop when your hands are slightly above eye level before initiating the next repetition."
    ],
    "breathing": "Exhale as you sweep the bar down toward your thighs, and inhale as you return the bar overhead under control.",
    "cues": [
      "Drive your hands toward your pockets.",
      "Lock your elbows in place throughout.",
      "Keep your chest proud and brace your core."
    ],
    "common_faults": [
      {
        "fault": "Bending and extending the elbows, turning the movement into a triceps pushdown.",
        "correction": "Maintain a fixed, soft elbow angle throughout the entire range of motion and move purely from the shoulders."
      },
      {
        "fault": "Using excessive body English and swinging the torso.",
        "correction": "Lock your torso at a slight forward angle and keep your core braced to isolate the back muscles."
      }
    ],
    "safety": {
      "precautions": [
        "Do not allow the weight stack to pull your shoulders into painful hyperflexion at the top of the movement."
      ],
      "spotter": "not-needed"
    }
  },
