  "instructions": {
    "setup": [
      "Step onto the machine's initial step and select your desired speed or training program on the console.",
      "Stand tall with your chest up and rest your hands lightly on the handrails for balance only."
    ],
    "steps": [
      "As the revolving stairs move downward, place your leading foot flat onto the center of the next oncoming step.",
      "Drive through your heel and midfoot to extend your hip and knee, lifting your body upward.",
      "Alternate legs continuously in a smooth, steady climbing cadence without skipping steps."
    ],
    "breathing": "Breathe in a relaxed, rhythmic pattern matched to your stepping tempo.",
    "cues": [
      "Stand tall with an upright torso.",
      "Step through the whole foot, not just the toes.",
      "Keep hands light on the rails."
    ],
    "common_faults": [
      {
        "fault": "Leaning heavily onto the handrails and supporting body weight with the arms.",
        "correction": "Rest only your fingertips on the handrails for balance, keeping all body weight over the legs."
      },
      {
        "fault": "Climbing solely on the balls of the feet with heels hanging off the steps.",
        "correction": "Place the entire foot firmly on each step to engage the glutes and prevent excessive calf strain."
      },
      {
        "fault": "Hunching forward at the waist.",
        "correction": "Keep the chest proud, shoulders back, and hips slightly forward in an upright posture."
      }
    ],
    "safety": {
      "precautions": [
        "Begin at a slow speed to find your rhythm before increasing stepping rate.",
        "Keep clear of the base of the machine and locate the emergency stop button prior to starting."
      ],
      "spotter": "not-needed"
    }
  },
