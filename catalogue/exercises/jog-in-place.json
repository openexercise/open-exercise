  "instructions": {
    "setup": [
      "Stand upright with your feet hip-width apart and your core lightly braced.",
      "Bend your elbows to approximately ninety degrees, keeping your shoulders relaxed."
    ],
    "steps": [
      "Lift one knee toward hip height while swinging the opposite arm forward.",
      "Lower the foot back down to the ground under control, landing softly on the ball of your foot.",
      "Immediately switch sides, lifting the opposite knee and reversing your arm swing.",
      "Continue alternating legs in a smooth, rhythmic, running motion without traveling forward."
    ],
    "breathing": "Breathe rhythmically in through your nose and out through your mouth in cadence with your strides.",
    "cues": [
      "Stay light on your feet",
      "Pump arms from the shoulders",
      "Maintain a tall posture"
    ],
    "common_faults": [
      {
        "fault": "Landing heavily on the heels, increasing joint impact.",
        "correction": "Spring off and land lightly on the midfoot to balls of the feet with a slight knee bend."
      },
      {
        "fault": "Excessive forward or backward leaning of the torso.",
        "correction": "Keep the chest upright and engage the core to maintain a neutral spine."
      }
    ],
    "safety": {
      "precautions": [
        "Wear supportive athletic footwear to minimize repetitive impact on lower extremities."
      ],
