  "id": "oec:squat-hold",
  "instructions": {
    "setup": [
      "Stand tall with your feet approximately shoulder-width apart, toes pointing slightly outward.",
      "Brace your core and bring your hands together in front of your chest for balance."
    ],
    "steps": [
      "Hinge at the hips and bend your knees to lower into a squat until your thighs are roughly parallel to the floor.",
      "Hold this position statically without rising or sinking deeper, keeping your chest proud and your weight distributed across your whole foot.",
      "Maintain the static hold for the targeted duration or until technical failure.",
      "Press through your midfoot and heels to stand back up to the starting position."
    ],
    "breathing": "Breathe continuously and steadily throughout the hold rather than holding your breath.",
    "cues": [
      "Chest up, weight balanced",
      "Knees tracking with your toes",
      "Stay rooted through the midfoot"
    ],
    "common_faults": [
      {
        "fault": "Knees caving inward during the hold.",
        "correction": "Actively push your knees outward in line with your toes."
      },
      {
        "fault": "Allowing the torso to collapse forward and rounding the spine.",
        "correction": "Keep your core braced and maintain an upright, proud chest."
      },
      {
        "fault": "Gradually creeping upward out of parallel depth as fatigue sets in.",
        "correction": "Commit to holding a consistent thigh-parallel depth throughout the duration."
      }
    ],
    "safety": {
      "precautions": [
        "If you reach complete muscular failure, simply lower safely down to the floor or place your hands on your knees to assist yourself up."
      ],
      "spotter": "not-needed"
    }
  },
