  "id": "oec:dumbbell-high-biceps-curl",
  "instructions": {
    "setup": [
      "Stand upright holding a dumbbell in one hand with an underhand (supinated) grip.",
      "Raise your working arm forward until your upper arm is parallel to the floor and your elbow is level with your shoulder.",
      "Brace your core and keep your torso upright and still."
    ],
    "steps": [
      "Keeping your upper arm fixed and elevated, curl the dumbbell toward your shoulder.",
      "Squeeze your biceps firmly at peak contraction without letting your elbow drop.",
      "Lower the dumbbell under control, extending your elbow back out until you feel a full stretch in the biceps.",
      "Complete all repetitions for one arm before switching to the other side."
    ],
    "breathing": "Exhale as you curl the weight toward your shoulder and inhale as you lower it back to the extended position.",
    "cues": [
      "Keep the elbow high and still.",
      "Isolate the forearm movement.",
      "Control the eccentric stretch."
    ],
    "common_faults": [
      {
        "fault": "Dropping the elbow as the weight curls inward.",
        "correction": "Actively hold the upper arm level with the shoulder throughout the entire range of motion."
      },
      {
        "fault": "Using torso momentum to swing the dumbbell up.",
        "correction": "Reduce the load and keep your spine vertical and core braced."
      },
      {
        "fault": "Rushing the eccentric lowering phase.",
        "correction": "Lower the weight slowly under tension until the arm is fully extended."
      }
    ],
    "safety": {
      "precautions": [
        "Use moderate loads to prevent shoulder fatigue from compromising shoulder stability."
      ],
      "spotter": "not-needed"
    }
  },
