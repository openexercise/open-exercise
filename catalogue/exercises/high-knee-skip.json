  "id": "oec:high-knee-skip",
  "instructions": {
    "setup": [
      "Stand tall with feet hip-width apart and arms relaxed at your sides.",
      "Engage your core, keep your chest upright, and direct your gaze forward."
    ],
    "steps": [
      "Push forcefully off the ball of one foot into a skip while driving the opposite knee upward until the thigh is parallel to the ground.",
      "Dorsiflex the ankle of the raised leg so the toes point upward.",
      "Drive the opposite arm forward and upward with a bent elbow in coordination with the lead leg.",
      "Land lightly on the ball of the stance foot, initiate a quick double-bounce rhythm, and immediately drive the opposite knee upward to continue skipping."
    ],
    "breathing": "Maintain a steady, rhythmic breathing pattern timed with the skips.",
    "cues": [
      "Knee up, toe up.",
      "Spring off the balls of your feet.",
      "Stay tall through your torso."
    ],
    "common_faults": [
      {
        "fault": "Leaning backward as the knee drives up.",
        "correction": "Brace the abdominals and maintain a tall, slightly forward-biased athletic posture."
      },
      {
        "fault": "Allowing the foot of the raised leg to dangle in plantarflexion.",
        "correction": "Actively pull the toes toward the shin (dorsiflexion) as the knee elevates."
      },
      {
        "fault": "Landing flat-footed or on the heels.",
        "correction": "Stay light and springy on the balls of your feet to maximize elastic recoil."
      }
    ],
    "safety": {
      "precautions": [
        "Perform on a flat, non-slip, and shock-absorbing surface like a track, grass, or gym floor."
      ],
      "spotter": "not-needed"
    }
  },
