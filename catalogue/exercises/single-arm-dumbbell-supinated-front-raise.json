  "instructions": {
    "setup": [
      "Stand upright with your feet hip-width apart, holding a dumbbell in one hand at your side.",
      "Turn your wrist into a fully supinated (underhand) grip with your palm facing forward.",
      "Set a slight, fixed bend in your working elbow and brace your core."
    ],
    "steps": [
      "Raise the dumbbell upward and slightly inward toward chest and shoulder height, maintaining the supinated palm orientation.",
      "Pause briefly at the top to squeeze your upper chest and front deltoid.",
      "Lower the dumbbell smoothly along the same path back to your side.",
      "Complete the assigned repetitions before repeating on the opposite arm."
    ],
    "breathing": "Exhale as you lift the dumbbell upward and inhale as you lower it back down.",
    "cues": [
      "Lead with your palm.",
      "Scoop up and across.",
      "Keep the elbow angle locked."
    ],
    "common_faults": [
      {
        "fault": "Turning the movement into a biceps curl by flexing the elbow during the lift.",
        "correction": "Maintain a static, soft bend in the elbow throughout the entire repetition."
      },
      {
        "fault": "Swinging the torso backward to generate momentum.",
        "correction": "Keep your ribcage down and use a weight you can control strictly with your shoulder."
      }
    ],
    "safety": {
      "precautions": [
        "Stop the lift at shoulder height if you experience joint pinching in the front of the shoulder."
      ],
      "spotter": "not-needed"
    }
  },
