  "instructions": {
    "setup": [
      "Stand tall with feet hip-width apart, shoulders relaxed, and arms loose at your sides.",
      "Fix your gaze straight ahead with your chin level and torso upright."
    ],
    "steps": [
      "Step forward with one foot, striking lightly with the heel and rolling through to push off with the forefoot.",
      "Simultaneously swing the opposite arm forward in a natural, fluid arc.",
      "Repeat with the other leg to establish a continuous, rhythmic walking gait.",
      "Maintain a steady cadence and upright posture throughout the bout."
    ],
    "breathing": "Breathe naturally and rhythmically in synchronization with your stride cadence.",
    "cues": [
      "Tall posture",
      "Heel to toe roll",
      "Relax the shoulders",
      "Natural arm swing"
    ],
    "common_faults": [
      {
        "fault": "Slouching forward or looking down at the feet",
        "correction": "Keep your gaze forward toward the horizon and pull your shoulders gently back and down."
      },
      {
        "fault": "Overstriding by reaching the lead foot too far forward",
        "correction": "Take shorter, quicker strides so your foot lands closer beneath your center of mass."
      }
    ],
