  "id": "oec:squat-thrust",
  "instructions": {
    "setup": [
      "Stand tall with your feet shoulder-width apart and arms relaxed at your sides."
    ],
    "steps": [
      "Hinge at the hips and bend your knees to squat down, placing both hands flat on the floor roughly shoulder-width apart just inside or in front of your feet.",
      "Jump both feet backward simultaneously to land in a rigid high plank position with arms fully extended.",
      "Immediately jump both feet forward toward your hands, landing in a deep squat position.",
      "Drive through your feet to stand fully upright to complete the repetition."
    ],
    "breathing": "Inhale as you drop down to the floor, exhale forcefully as you kick out into plank, and maintain rhythmic breathing as you return to standing.",
    "cues": [
      "Hands down, feet back, feet in, stand tall.",
      "Lock your core in the plank to prevent hip sag.",
      "Land softly on the balls of your feet when kicking back."
    ],
    "common_faults": [
      {
        "fault": "Letting the lower back arch and hips sag into hyperextension during the plank position.",
        "correction": "Brace your abdominals and squeeze your glutes as your feet hit the back position to maintain a straight line from head to heels."
      },
      {
        "fault": "Landing on the toes with knees collapsed inward when returning from the plank.",
        "correction": "Jump your feet outside your hands and aim to land flat-footed or on a stable base with knees tracking in line with your toes."
      }
    ],
    "safety": {
      "precautions": [
        "Maintain wrist and shoulder alignment directly over your hands when in the plank position to minimize joint strain."
      ],
      "spotter": "not-needed"
    }
  },
