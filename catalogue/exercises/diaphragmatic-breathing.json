  "id": "oec:diaphragmatic-breathing",
  "instructions": {
    "setup": [
      "Sit upright in a chair with your feet flat on the floor, or stand tall with feet hip-width apart.",
      "Relax your shoulders, neck, and jaw.",
      "Place one hand on your upper chest and the other on your abdomen just below the ribcage to monitor movement."
    ],
    "steps": [
      "Inhale slowly and deeply through your nose, allowing your abdomen to expand outward three-dimensionally while keeping your chest relatively still.",
      "Pause briefly at the top of the inhalation without straining.",
      "Exhale slowly and completely through your mouth or nose, feeling your abdomen gently draw inward toward your spine.",
      "Repeat for the desired duration or breath count, maintaining a steady, relaxed rhythm."
    ],
    "breathing": "Breathe slowly and rhythmically, emphasizing a full diaphragmatic expansion on the inhale and a controlled, complete exhale.",
    "cues": [
      "Breathe into your stomach, not your shoulders",
      "Expand the ribs 360 degrees",
      "Keep the upper chest relaxed"
    ],
    "common_faults": [
      {
        "fault": "Shrugging the shoulders and initiating the breath primarily from the upper chest.",
        "correction": "Consciously depress and relax your shoulder girdle, directing the air downward so only the bottom hand moves on the inhale."
      },
      {
        "fault": "Hyperextending the lower back during inhalation.",
        "correction": "Keep your pelvis and ribcage stacked in neutral without overarching your lumbar spine."
      }
    ],
    "safety": {
      "precautions": [
        "If you feel lightheaded or dizzy, pause the drill and resume normal spontaneous breathing."
      ],
      "spotter": "not-needed"
    }
  },
