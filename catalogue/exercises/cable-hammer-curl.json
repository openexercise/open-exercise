  "instructions": {
    "setup": [
      "Attach a rope or dual handles to the lowest pulley setting of a cable station.",
      "Grasp the rope with a neutral grip (palms facing each other) near the knotted ends.",
      "Step back slightly to put tension on the cable, standing upright with feet hip-width apart and elbows pinned to your sides."
    ],
    "steps": [
      "Curl your hands toward your shoulders by flexing the elbows, keeping your upper arms stationary.",
      "Squeeze your arm muscles firmly at the peak of the contraction without allowing your elbows to drift forward.",
      "Lower the weight back down slowly under control until your elbows reach full extension."
    ],
    "breathing": "Exhale as you curl the weight up, and inhale as you lower it back down.",
    "cues": [
      "Keep palms facing each other throughout.",
      "Pin your elbows to your ribs.",
      "Control the descent; don't let the stack snap down."
    ],
    "common_faults": [
      {
        "fault": "Swinging the torso to use momentum to move the weight.",
        "correction": "Brace your core and maintain a strict, upright posture throughout the entire movement."
      },
      {
        "fault": "Allowing the elbows to drift forward during the curl.",
        "correction": "Keep your upper arms stationary and tucked close to your torso."
      }
    ],
    "safety": {
      "precautions": [
        "Maintain a neutral wrist position to avoid excessive strain on the joint."
      ],
      "spotter": "not-needed"
    }
  },
