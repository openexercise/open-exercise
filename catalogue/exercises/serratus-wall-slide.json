  "instructions": {
    "setup": [
      "Stand facing a wall with your forearms on it, palms in, elbows at about shoulder height.",
      "Angle your forearms slightly outward from vertical."
    ],
    "steps": [
      "Push your forearms gently into the wall, spreading your shoulder blades apart around your ribs.",
      "Keeping that pressure, slide your forearms up the wall until your elbows are about level with your chin.",
      "Slide them back down under control and repeat."
    ],
    "cues": [
      "Push the wall away",
      "Shoulders down, away from your ears"
    ],
    "safety": {
      "precautions": [
        "Stop short of any pinching at the front or top of the shoulder."
      ],
      "spotter": "not-needed"
    }
