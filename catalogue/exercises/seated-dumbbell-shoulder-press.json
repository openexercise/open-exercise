  "instructions": {
    "setup": [
      "Adjust a bench backrest to a nearly vertical position, roughly 75 to 85 degrees.",
      "Sit back firmly against the pad with feet flat on the floor.",
      "Kick the dumbbells up from your knees one at a time to shoulder height, holding them with your elbows positioned slightly forward in the scapular plane."
    ],
    "steps": [
      "Press both dumbbells vertically upward until your arms are fully extended overhead without violently locking your elbows.",
      "Pause briefly at the top while keeping the weights balanced over your shoulders.",
      "Lower the dumbbells in a controlled descent back to just above shoulder level."
    ],
    "breathing": "Inhale before pressing or as you lower the weights, and exhale forcefully as you drive the dumbbells overhead.",
    "cues": [
      "Press yourself down into the seat.",
      "Keep elbows slightly in front of your shoulders, not flared wide.",
      "Control the descent all the way to the shoulders."
    ],
    "common_faults": [
      {
        "fault": "Excessively arching the lower back off the pad to press at a flatter angle.",
        "correction": "Brace your core, keep your ribcage down, and maintain full contact between your upper back, hips, and the seat."
      },
      {
        "fault": "Flaring elbows completely out to the sides.",
        "correction": "Tuck elbows roughly 30 to 45 degrees forward into the scapular plane to protect the shoulder joints."
      },
      {
        "fault": "Clanging the dumbbells together at the top.",
        "correction": "Press straight up and slightly inward along a natural arc without colliding the weights."
      }
    ],
    "safety": {
      "precautions": [
        "If you reach failure, lower the dumbbells under control to your knees rather than dropping them to the sides."
      ],
      "spotter": "recommended"
    }
  },
