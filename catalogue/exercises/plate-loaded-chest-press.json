  "instructions": {
    "setup": [
      "Load the machine sleeves evenly with weight plates.",
      "Adjust the seat height so the handles align across the mid-to-lower chest.",
      "Sit back firmly against the pad with your feet flat on the floor.",
      "Grasp the handles with an overhand grip and retract your shoulder blades."
    ],
    "steps": [
      "Press the handles smoothly forward by extending your elbows and contracting your chest.",
      "Extend until your arms are nearly straight without forcefully locking out your elbows.",
      "Lower the handles under control until you feel a comfortable stretch across your pectorals.",
      "Pause briefly at the bottom before initiating the next repetition."
    ],
    "breathing": "Inhale as you lower the weight toward your chest; exhale forcefully as you press forward.",
    "cues": [
      "Drive through your palms",
      "Keep your shoulders pinned to the pad",
      "Squeeze your chest at the top"
    ],
    "common_faults": [
      {
        "fault": "Seat adjusted too high or low",
        "correction": "Ensure handles align with the middle of your sternum to avoid excess shoulder impingement."
      },
      {
        "fault": "Protracted, rounded shoulders at the finish",
        "correction": "Keep your shoulder blades retracted and depressed against the backrest throughout the press."
      },
      {
        "fault": "Bouncing the weight off the machine stops",
        "correction": "Control the eccentric phase and stop just short of bottoming out the lever arms."
      }
    ],
    "safety": {
      "precautions": [
        "Use the foot-assist pedal if available to bring the handles forward into the starting position safely."
      ],
      "spotter": "not-needed"
    }
  },
