  "instructions": {
    "setup": [
      "Set the bar at about shoulder height and the safeties just below the bottom of your squat.",
      "Step under the bar, rest it on your upper back, and walk it out in two or three steps."
    ],
    "steps": [
      "Brace your trunk.",
      "Bend your hips and knees together, keeping the bar over the middle of your foot.",
      "Descend until your hips are at least level with your knees.",
      "Drive through the whole foot to stand."
    ],
    "breathing": "Breathe in and brace before descending; exhale after the hardest part of the way up.",
    "cues": [
      "Spread the floor",
      "Chest and hips rise together"
    ],
    "common_faults": [
      {
        "fault": "Knees cave in on the way up",
        "correction": "Push the knees out in line with the toes and lower the load."
      },
      {
        "fault": "Hips shoot up first",
        "correction": "Keep the chest rising with the hips."
      }
    ],
    "safety": {
      "precautions": [
        "Use safeties or a spotter when near your limit."
      ],
      "spotter": "recommended",
      "safeties": true
    }
